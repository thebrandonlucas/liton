(test "Liton — Settings is a page: it opens at the surface's section, a section picked covers the list on a phone until ← goes back, and ← Back closes it"
  (steps
    (press "Control+,")
    (expect-visible (role region :name "Settings"))
    (expect-attr (role button :name "Surface") aria-pressed "true")
    (expect-attr (role region :name "Settings") class "settings")
    (expect-visible (role button :name "Developer preset"))
    (click (role button :name "Appearance"))
    (expect-attr (role button :name "Appearance") aria-pressed "true")
    (expect-attr (role button :name "Surface") aria-pressed "false")
    (expect-attr (role region :name "Settings") class "settings pushed")
    (expect-visible (label "Glass"))
    (expect-absent (role button :name "Developer preset"))
    (click (role button :name "Back to the sections"))
    (expect-attr (role region :name "Settings") class "settings")
    (expect-attr (role button :name "Appearance") aria-pressed "true")
    (click (role button :name "Snapshot"))
    (expect-visible (role button :name "Load snapshot"))
    (click (role button :name "Close settings"))
    (expect-absent (role region :name "Settings"))
    (press "Control+,")
    (expect-attr (role region :name "Settings") class "settings")
    (expect-attr (role button :name "Snapshot") aria-pressed "true")
    (press "Escape")
    (expect-absent (role region :name "Settings"))
  )
)
