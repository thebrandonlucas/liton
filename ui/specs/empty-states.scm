(test "Liton — the Developer preset's main area says what to do while there is nothing to chat with: on a first run, where projects come from, with what is connected a click away; then to pick a workspace or create one; and in a workspace of no agents, to start one"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"workspaces\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[]}]},{\"capability\":\"attention.v1\",\"topic\":\"items\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspaces.v1\",\"topic\":\"list\",\"cursor\":\"l1\",\"events\":[{\"Listed\":{\"projects\":[],\"workspaces\":[]}}]}]}")
    (run-effect 2)
    (expect-text (test-id "empty-state") "No projects yetliton shows the projects of the providers its daemon connects. Start the daemon with PASEO_PASSWORD set to connect Paseo, or LITON_PROVIDERS for other providers, and their projects and workspaces appear here.See what's connected")
    (click (role button :name "See what's connected"))
    (expect-attr (role tab :name "Capabilities") aria-selected "true")
    (click (role button :name "Close Capabilities"))
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c2\",\"events\":[]},{\"capability\":\"workspaces.v1\",\"topic\":\"list\",\"cursor\":\"l2\",\"events\":[{\"Listed\":{\"projects\":[{\"directory\":\"/src/app\",\"id\":\"p1\",\"name\":\"app\",\"provider\":\"mock\"}],\"workspaces\":[{\"branch\":{\"Branch\":\"scratch\"},\"changes\":\"Uncounted\",\"directory\":\"/src/app\",\"dirty\":false,\"id\":\"w3\",\"kind\":\"Worktree\",\"labels\":[],\"name\":\"scratch\",\"pinned\":false,\"project_id\":\"p1\",\"provider\":\"mock\",\"session_ids\":[],\"state\":\"Idle\"}]}}]}]}")
    (run-effect 3)
    (expect-text (test-id "empty-state") "Pick a workspaceIts agents show here as tabs, its changes and files beside them.Create a workspace")
    (click (role button :name "Create a workspace"))
    (expect-visible (role button :name "Create"))
    (click (role button :name "Cancel"))
    (click (role button :name "scratch"))
    (expect-text (test-id "empty-state") "No agents in scratch yetStart one to work in this workspace: it shows here as a tab.Start an agent")
    (click (role button :name "Start an agent"))
    (expect-visible (text "New agent in scratch"))
  )
)
