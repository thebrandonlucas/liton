(test "Liton — the daemon's setup offers its presets in place of liton's own, in Settings and not the bar, and starts with its default"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[],\"setup\":{\"default_preset\":\"Review\",\"default_theme\":\"\",\"themes\":[],\"presets\":[{\"name\":\"Developer\",\"snapshot\":{\"version\":6,\"theme\":\"\",\"shell\":\"Workbench\",\"collapsed\":[],\"hidden\":[],\"grid\":{\"columns\":[1,1,1],\"rows\":[1],\"tiles\":[{\"id\":\"tile-1\",\"left\":0,\"top\":0,\"right\":1,\"bottom\":1,\"active\":\"pane-1\",\"panes\":[{\"id\":\"pane-1\",\"widget\":\"sessions\",\"pinned\":\"\",\"options\":[]}]},{\"id\":\"tile-2\",\"left\":1,\"top\":0,\"right\":2,\"bottom\":1,\"active\":\"pane-2\",\"panes\":[{\"id\":\"pane-2\",\"widget\":\"chat\",\"pinned\":\"\",\"options\":[]}]},{\"id\":\"tile-3\",\"left\":2,\"top\":0,\"right\":3,\"bottom\":1,\"active\":\"pane-3\",\"panes\":[{\"id\":\"pane-3\",\"widget\":\"capabilities\",\"pinned\":\"\",\"options\":[]}]}]}}},{\"name\":\"Review\",\"snapshot\":{\"version\":6,\"theme\":\"\",\"shell\":\"Tiling\",\"collapsed\":[],\"hidden\":[],\"grid\":{\"columns\":[1],\"rows\":[1],\"tiles\":[{\"id\":\"tile-1\",\"left\":0,\"top\":0,\"right\":1,\"bottom\":1,\"active\":\"pane-1\",\"panes\":[{\"id\":\"pane-1\",\"widget\":\"chat\",\"pinned\":\"\",\"options\":[{\"key\":\"show_status\",\"value\":\"false\"}]}]}]}}}]}}")
    (run-effect 1)
    (expect-absent (role button :name "2 Review") :never-drawn)
    (expect-visible (role region :name "Chat"))
    (expect-absent (role region :name "Sessions"))
    (click (role button :name "Settings"))
    (expect-attr (role button :name "Review preset") aria-pressed "true")
    (expect-attr (role button :name "Developer preset") aria-pressed "false")
    (expect-absent (role button :name "Inbox preset") :never-drawn)
    (click (role button :name "Developer preset"))
    (expect-attr (role button :name "Developer preset") aria-pressed "true")
    (expect-attr (role button :name "Review preset") aria-pressed "false")
    (expect-visible (role region :name "Sessions"))
  )
)
