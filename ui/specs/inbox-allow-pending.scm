(test "Liton — Allow in the inbox shows the answer at once, and a rejected one brings the prompt back"
  (steps
    (stub-http "manifest" :url "/api/manifest" :status 200 :body "{\"protocol\":1,\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"},{\"capabilities\":[{\"name\":\"attention\",\"version\":1}],\"id\":\"liton\",\"name\":\"liton\"}]}")
    (run-effect 1)
    (click (role button :name "Settings"))
    (click (role button :name "Inbox preset"))
    (stub-http "attention" :url "/api/attention" :status 200 :body "[{\"agent\":\"claude\",\"permissions\":[{\"description\":\"rm -rf build\",\"request_id\":\"p1\",\"tool\":\"bash\"}],\"provider\":\"mock\",\"session_id\":\"s1\",\"set_aside\":\"No\",\"signature\":\"NeedsYou 1 p1\",\"state\":\"NeedsYou\",\"summary\":\"\",\"title\":\"Fix tests\"}]")
    (run-effect 3)
    (expect-visible (text "Allow bash: rm -rf build?"))
    (click (role button :name "Allow Fix tests"))
    ; Shown before the daemon answers.
    (expect-absent (role button :name "Allow Fix tests"))
    (expect-text (test-id "answer-status") "Allowing…")
    (stub-http "answer" :url "/api/chat" :status 200 :body "{\"Rejected\":\"no pending permission request p1\"}")
    (run-effect 4)
    (expect-text (test-id "answer-status") "")
    (expect-visible (role button :name "Allow Fix tests"))
    (expect-visible (text "no pending permission request p1"))
    (click (role button :name "Allow Fix tests"))
    (expect-text (test-id "answer-status") "Allowing…")
    (stub-http "answer" :url "/api/chat" :status 200 :body "\"Accepted\"")
    (run-effect 5)
    (stub-http "attention" :url "/api/attention" :status 200 :body "[{\"agent\":\"claude\",\"permissions\":[],\"provider\":\"mock\",\"session_id\":\"s1\",\"set_aside\":\"No\",\"signature\":\"Working 3\",\"state\":\"Working\",\"summary\":\"\",\"title\":\"Fix tests\"}]")
    (run-effect 7)
    (expect-absent (text "Allowing…"))
    (expect-visible (text "working"))
  )
)
