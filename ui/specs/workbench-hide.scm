(test "Liton — a Workbench pane's menu hides it at once, or the drawer it is the last of, and shows it again; hidden, it stays so after a reload"
  (steps
    (expect-visible (role button :name "Changes"))
    (expect-absent (role button :name "Show Changes"))
    (click (role button :name "Changes menu"))
    (expect-absent (role button :name "Close pane") :never-drawn)
    (click (role button :name "Hide Changes"))
    (expect-attr (role region :name "Changes") class "pane hidden")
    (expect-absent (role button :name "Changes"))
    (expect-attr (role button :name "Files") aria-pressed "true")
    (expect-attr (role region :name "Files") class "pane focused")
    (expect-text (test-id "show-right") "Files")
    (navigate "/")
    (expect-attr (role region :name "Changes") class "pane hidden")
    (expect-text (test-id "show-right") "Files")
    ; The last pane a drawer shows hides the drawer, which shows it again.
    (click (role button :name "Files menu"))
    (click (role button :name "Hide right drawer"))
    (expect-attr (role button :name "Right drawer") aria-expanded "false")
    (click (role button :name "Right drawer"))
    (expect-attr (role region :name "Files") class "pane")
    (click (role button :name "Files menu"))
    (click (role button :name "Show Changes"))
    (expect-attr (role region :name "Changes") class "pane focused")
    (expect-attr (role button :name "Changes") aria-pressed "true")
    (expect-text (test-id "show-right") "Changes · Files")
  )
)
