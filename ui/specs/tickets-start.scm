(test "Liton — Start on a ticket of liton's own moves it to In progress at once, then makes a worktree of its repo on a branch named for it and starts an agent there; a worktree refused puts its status back, with why"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"tickets\",\"version\":1}],\"id\":\"tickets\",\"name\":\"Tickets\"},{\"capabilities\":[{\"name\":\"workspaces\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]}]}")
    (run-effect 2)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]}]}")
    (run-effect 3)
    (click (role button :name "Tickets"))
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"workspaces.v1\",\"topic\":\"list\",\"cursor\":\"w1\",\"events\":[{\"Listed\":{\"projects\":[{\"directory\":\"/src/liton\",\"id\":\"p-liton\",\"name\":\"liton\",\"provider\":\"mock\"}],\"workspaces\":[]}}]},{\"capability\":\"chat.v1\",\"topic\":\"agents\",\"cursor\":\"a1\",\"events\":[{\"Agents\":[{\"provider\":\"mock\",\"agent\":\"claude\",\"models\":[{\"id\":\"opus\",\"label\":\"Opus\",\"default\":true,\"thinking\":[]}]}]}]},{\"capability\":\"tickets.v1\",\"topic\":\"list\",\"cursor\":\"l1\",\"events\":[{\"Tickets\":{\"sources\":[{\"id\":\"tickets/p1\",\"provider\":\"tickets\",\"name\":\"liton\",\"url\":\"\",\"people\":[],\"repo\":\"p-liton\",\"statuses\":[{\"id\":\"todo\",\"name\":\"Todo\",\"kind\":\"Open\"},{\"id\":\"in_progress\",\"name\":\"In progress\",\"kind\":\"Started\"},{\"id\":\"done\",\"name\":\"Done\",\"kind\":\"Done\"}]}],\"tickets\":[{\"id\":\"tickets/1\",\"provider\":\"tickets\",\"source\":\"tickets/p1\",\"key\":\"LIT-1\",\"title\":\"Drop images\",\"url\":\"\",\"status\":{\"id\":\"todo\",\"name\":\"Todo\",\"kind\":\"Open\"},\"assignees\":[],\"labels\":[\"ui\"],\"waiting_on\":[],\"updated\":\"2026-01-01T08:30:00.000Z\"}]}}]},{\"capability\":\"tickets.v1\",\"topic\":\"links\",\"cursor\":\"k1\",\"events\":[{\"Links\":[]}]}]}")
    (run-effect 4)
    (click (role button :name "LIT-1 Drop images"))
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"workspaces.v1\",\"topic\":\"list\",\"cursor\":\"w1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"agents\",\"cursor\":\"a1\",\"events\":[]},{\"capability\":\"tickets.v1\",\"topic\":\"list\",\"cursor\":\"l0\",\"events\":[]},{\"capability\":\"tickets.v1\",\"topic\":\"links\",\"cursor\":\"k1\",\"events\":[]},{\"capability\":\"tickets.v1\",\"topic\":\"ticket/tickets/1\",\"cursor\":\"t1\",\"events\":[{\"Ticket\":{\"summary\":{\"id\":\"tickets/1\",\"provider\":\"tickets\",\"source\":\"tickets/p1\",\"key\":\"LIT-1\",\"title\":\"Drop images\",\"url\":\"\",\"status\":{\"id\":\"todo\",\"name\":\"Todo\",\"kind\":\"Open\"},\"assignees\":[],\"labels\":[\"ui\"],\"waiting_on\":[],\"updated\":\"2026-01-01T08:30:00.000Z\"},\"body\":\"In the composer.\",\"comments\":[]}}]}]}")
    (run-effect 5)
    (expect-value (label "Set the repo") "p-liton")
    (expect-value (label "Agent to start") "claude")
    (click (role button :name "Start"))
    (expect-text (test-id "ticket-status") "In progress")
    (expect-visible (role button :name "Starting…"))
    (stub-http "status" :url "/liton/v1/call" :status 200 :body "{\"Ok\":\"Accepted\"}")
    (run-effect 6)
    (expect-visible (role button :name "Starting…"))
    (stub-http "worktree" :url "/liton/v1/call" :status 200 :body "{\"Err\":{\"code\":\"BadRequest\",\"message\":\"the branch exists\"}}")
    (run-effect 8)
    (expect-visible (text "the branch exists"))
    (expect-visible (role button :name "Start"))
    (expect-text (test-id "ticket-status") "Todo")
  )
)
