(test "Liton — while its agent works on a turn, waiting for you too, the chat shows a loader and for how long, by the second"
  (setup (initial-time "2026-01-01T10:03:46Z"))
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"running_since\":\"2026-01-01T10:00:00.000Z\",\"status\":\"Running\",\"title\":\"Fix tests\"}]}]}]}")
    (run-effect 2)
    (expect-visible (role status :name "Working"))
    (expect-text (test-id "working") "3m 46s")
    (advance-time 1000)
    (tick-interval 1000)
    (expect-text (test-id "working") "3m 47s")
    ; It holds while the agent waits for you mid-turn.
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c2\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"running_since\":\"2026-01-01T10:00:00.000Z\",\"status\":\"AwaitingPermission\",\"title\":\"Fix tests\"}]}]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/s1\",\"cursor\":\"1\",\"events\":[{\"Entry\":{\"event\":{\"PermissionRequested\":{\"description\":\"src/Main.roc\",\"request_id\":\"p1\",\"tool\":\"edit\"}},\"sequence\":1}}]}]}")
    (run-effect 3)
    (expect-visible (text "Allow edit: src/Main.roc?"))
    (advance-time 60000)
    (tick-interval 1000)
    (expect-text (test-id "working") "4m 47s")
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c3\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Fix tests\"}]}]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/s1\",\"cursor\":\"1\",\"events\":[]}]}")
    (run-effect 4)
    (expect-absent (role status :name "Working"))
  )
)
