(test "Liton — the sign-in screen signs in with a passkey, shown as signing in at once: the daemon's challenge, the browser's passkey, then the UI; a passkey the daemon refuses says why"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 401 :body "this device isn't paired with the daemon")
    (run-effect 1)
    (click (role button :name "Sign in with a passkey"))
    ; Signing in at once, before the daemon answers.
    (expect-visible (role button :name "Signing in…"))
    (stub-http "begin" :url "/liton/v1/login/begin" :status 200 :body "{\"challenge\":\"c1\"}")
    (run-effect 3)
    (expect-port-call 4 "liton/passkey" "{\"create\":false,\"name\":\"Browser\",\"options\":\"{\\\"challenge\\\":\\\"c1\\\"}\",\"person_name\":\"\"}")
    (answer-port 4 reply "\"{}\"")
    (stub-http "finish" :url "/liton/v1/login/finish" :status 401 :body "this passkey isn't one of this box's people's")
    (run-effect 5)
    (expect-text (test-id "passkey-failed") "This passkey isn't one of this box's people's. Ask for an invite.")
    (click (role button :name "Sign in with a passkey"))
    (expect-visible (role button :name "Signing in…"))
    (stub-http "begin" :url "/liton/v1/login/begin" :status 200 :body "{\"challenge\":\"c2\"}")
    (run-effect 6)
    (answer-port 7 reply "\"{}\"")
    (stub-http "finish" :url "/liton/v1/login/finish" :status 200 :body "{\"device\":{\"id\":\"d1\",\"name\":\"Browser\"},\"person\":{\"id\":\"p1\",\"name\":\"Ada\",\"role\":\"operator\"}}")
    (run-effect 8)
    (expect-absent (role button :name "Sign in with a passkey"))
  )
)
