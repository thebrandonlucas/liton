(test "Liton — a message the room refuses stays with why, to retry, still pending until answered, or to discard"
  (setup
    (local-storage "liton.snapshot" "{\"version\":6,\"shell\":\"Tiling\",\"columns\":[{\"id\":\"column-1\",\"size\":1,\"tabbed\":false,\"active\":\"pane-1\",\"panes\":[{\"id\":\"pane-1\",\"widget\":\"rooms\",\"pinned\":\"\",\"options\":[]}]}],\"collapsed\":[],\"hidden\":[],\"theme\":\"\"}"))
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"rooms\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    ; The poll sent before the manifest arrived, for every capability.
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[]}")
    (run-effect 2)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"rooms.v1\",\"topic\":\"rooms\",\"cursor\":\"r1\",\"events\":[{\"Rooms\":[{\"id\":\"releases\",\"provider\":\"mock\",\"name\":\"releases\",\"kind\":\"Announce\",\"private\":false,\"archived\":false,\"joined\":true,\"unread\":\"Unknown\",\"links\":[],\"me\":\"you\"}]}]}]}")
    (run-effect 3)
    (click (role button :name "#releases"))
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"rooms.v1\",\"topic\":\"rooms\",\"cursor\":\"r1\",\"events\":[]},{\"capability\":\"rooms.v1\",\"topic\":\"messages/releases\",\"cursor\":\"1\",\"events\":[{\"RoomEntry\":{\"sequence\":1,\"event\":{\"Posted\":{\"id\":\"releases-1\",\"room_id\":\"releases\",\"author\":\"ada\",\"text\":\"liton 0.1 is out.\",\"time\":\"2026-01-01T09:00:00.000Z\",\"place\":\"TopLevel\",\"mentions\":[],\"reactions\":[],\"edited\":false,\"deleted\":false}}}}]},{\"capability\":\"rooms.v1\",\"topic\":\"members/releases\",\"cursor\":\"m1\",\"events\":[{\"Members\":[{\"id\":\"ada\",\"provider\":\"mock\",\"name\":\"Ada\",\"kind\":\"Person\",\"role\":\"Admin\",\"presence\":\"Away\"}]}]}]}")
    (run-effect 4)
    (fill (label "Your message") "Congrats!")
    (click (role button :name "Send to the room"))
    (expect-text (test-id "room-sent-status") "Sending…")
    (expect-visible (text "Congrats!"))
    (stub-http "send" :url "/liton/v1/call" :status 200 :body "{\"Ok\":{\"Rejected\":\"only Ada announces in #releases\"}}")
    (run-effect 5)
    (expect-text (test-id "room-sent-status") "Not sent: only Ada announces in #releases")
    (expect-text (test-id "notice") "only Ada announces in #releases")
    (click (role button :name "Retry"))
    (expect-pending-effects 1)
    (expect-text (test-id "room-sent-status") "Sending…")
    (stub-http "send" :url "/liton/v1/call" :status 200 :body "{\"Err\":{\"code\":\"Refused\",\"message\":\"only Ada announces in #releases\"}}")
    (run-effect 6)
    (expect-text (test-id "room-sent-status") "Not sent: only Ada announces in #releases")
    (click (role button :name "Discard"))
    (expect-absent (test-id "room-sent-status"))
    (expect-absent (text "Congrats!"))
  )
)
