(test "Liton — a chat pane's options in settings hide its tool output and status lines at once"
  (steps
    (stub-http "manifest" :url "/api/manifest" :status 200 :body "{\"protocol\":1,\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}]}")
    (run-effect 1)
    (stub-http "poll" :url "/api/chat/poll" :status 200 :body "{\"sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Running\",\"title\":\"Fix tests\"}],\"timelines\":[]}")
    (run-effect 2)
    (stub-http "poll" :url "/api/chat/poll" :status 200 :body "{\"sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Running\",\"title\":\"Fix tests\"}],\"timelines\":[{\"session_id\":\"s1\",\"entries\":[{\"event\":{\"ToolCall\":{\"call_id\":\"c1\",\"input\":\"ls\",\"tool\":\"bash\"}},\"sequence\":1},{\"event\":{\"ToolResult\":{\"call_id\":\"c1\",\"failed\":false,\"output\":\"a\\nb\"}},\"sequence\":2},{\"event\":{\"StatusChanged\":\"Idle\"},\"sequence\":3}]}]}")
    (run-effect 3)
    (expect-visible (text "a\nb"))
    (expect-visible (text "idle"))
    (click (role button :name "Settings"))
    (expect-value (label "Tool output") "Folded")
    (select-option (label "Tool output") "Hidden")
    (expect-absent (text "a\nb"))
    (expect-visible (text "ls"))
    (uncheck (label "Show status lines"))
    (expect-absent (text "idle"))
  )
)
