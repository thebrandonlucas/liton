(test "Liton — a chat pane's options in settings hide its tool output and status lines at once"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Running\",\"title\":\"Fix tests\"}]}]}]}")
    (run-effect 2)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/s1\",\"cursor\":\"3\",\"events\":[{\"Entry\":{\"event\":{\"ToolCall\":{\"call_id\":\"c1\",\"input\":\"ls\",\"tool\":\"bash\"}},\"sequence\":1}},{\"Entry\":{\"event\":{\"ToolResult\":{\"call_id\":\"c1\",\"failed\":false,\"output\":\"a\\nb\"}},\"sequence\":2}},{\"Entry\":{\"event\":{\"StatusChanged\":\"Idle\"},\"sequence\":3}}]}]}")
    (run-effect 3)
    (expect-visible (text "a\nb"))
    (expect-visible (text "idle"))
    (click (role button :name "Settings"))
    (expect-value (label "Tool output") "Folded")
    (select-option (label "Tool output") "Hidden")
    (expect-absent (text "a\nb"))
    (expect-visible (text "ls"))
    (uncheck (label "Show status lines"))
    (expect-absent (text "idle"))
  )
)
