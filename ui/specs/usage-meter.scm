(test "Liton — beside Settings, a meter shows the 5-hour window and the week of the account nearest its limit, filling to the limit and amber near it; it opens Usage & limits, whose 5-hour limit's slider sets it at once"
  (setup (initial-time "2026-01-02T10:00:00Z"))
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"usage\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[{\"id\":\"limits\",\"name\":\"Limits\",\"offers\":{\"name\":\"limits\",\"version\":1},\"uses\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"usage\",\"version\":1}]}],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[]}")
    (run-effect 2)
    (expect-absent (test-id "usage-meter"))
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[]}]},{\"capability\":\"limits.v1\",\"topic\":\"status\",\"cursor\":\"s1\",\"events\":[{\"Limits\":{\"limits\":[{\"scope\":\"Week\",\"percent\":90}],\"sessions\":[],\"weeks\":[{\"provider\":\"mock\",\"source\":\"claude\",\"account\":\"me@example.com\",\"used_pct\":85,\"limit_pct\":90,\"state\":\"Near\",\"resets_at\":\"2026-01-04T10:00:00.000Z\"}],\"five_hours\":[{\"provider\":\"mock\",\"source\":\"claude\",\"account\":\"me@example.com\",\"used_pct\":40,\"state\":\"Ok\"}]}}]}]}")
    (run-effect 3)
    (expect-visible (test-id "usage-meter"))
    (expect-visible (role button :name "Usage: 5h 40% · wk 85% of 90%"))
    (click (role button :name "Usage: 5h 40% · wk 85% of 90%"))
    (expect-visible (role heading :name "Usage & limits"))
    (expect-text (test-id "five-hour-limit") "No limit")
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[]}")
    (run-effect 4)
    ; A 5-hour limit shows at once, in Settings and the meter.
    (change (label "5-hour limit") "50")
    (expect-text (test-id "five-hour-limit") "50% · saving…")
    (expect-visible (role button :name "Usage: 5h 40% of 50% · wk 85% of 90%"))
    (stub-http "limit" :url "/liton/v1/call" :status 200 :body "{\"Ok\":{\"Rejected\":\"the daemon is busy\"}}")
    (run-effect 5)
    (expect-text (test-id "five-hour-limit") "No limit")
    (expect-visible (role button :name "Usage: 5h 40% · wk 85% of 90%"))
  )
)
