(test "Liton — a row's ⋮ menu pins a workspace, or a session's, to the top and archives a workspace or a session, each shown at once and undone with why if refused"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"workspaces\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Running\",\"title\":\"Fix tests\",\"updated\":\"2026-01-01T10:00:00.000Z\",\"workspace\":{\"directory\":\"/src/app\",\"id\":\"w1\"}},{\"agent\":\"claude\",\"id\":\"s2\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Write docs\",\"updated\":\"2026-01-01T09:00:00.000Z\",\"workspace\":{\"directory\":\"/src/app\",\"id\":\"w2\"}}]}]},{\"capability\":\"attention.v1\",\"topic\":\"items\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspaces.v1\",\"topic\":\"list\",\"cursor\":\"l1\",\"events\":[{\"Listed\":{\"projects\":[{\"directory\":\"/src/app\",\"id\":\"p1\",\"name\":\"app\",\"provider\":\"mock\"}],\"workspaces\":[{\"branch\":{\"Branch\":\"main\"},\"changes\":\"Uncounted\",\"directory\":\"/src/app\",\"dirty\":false,\"id\":\"w1\",\"kind\":\"Checkout\",\"labels\":[],\"name\":\"main\",\"pinned\":false,\"project_id\":\"p1\",\"provider\":\"mock\",\"session_ids\":[\"s1\"],\"state\":\"Working\"},{\"branch\":{\"Branch\":\"docs\"},\"changes\":\"Uncounted\",\"directory\":\"/src/app\",\"dirty\":false,\"id\":\"w2\",\"kind\":\"Worktree\",\"labels\":[],\"name\":\"docs\",\"pinned\":false,\"project_id\":\"p1\",\"provider\":\"mock\",\"session_ids\":[\"s2\"],\"state\":\"Idle\"},{\"branch\":{\"Branch\":\"scratch\"},\"changes\":\"Uncounted\",\"directory\":\"/src/app\",\"dirty\":false,\"id\":\"w3\",\"kind\":\"Worktree\",\"labels\":[],\"name\":\"scratch\",\"pinned\":false,\"project_id\":\"p1\",\"provider\":\"mock\",\"session_ids\":[],\"state\":\"Idle\"}]}}]}]}")
    (run-effect 2)
    (expect-text (test-id "slot-left") "WorkspacesWorkspacesApp3Fix testsrunningWrite docsdocsidlescratch")
    ; A session is pinned through its workspace, first at once.
    (click (role button :name "Write docs menu"))
    (click (role button :name "Pin"))
    (expect-absent (role button :name "Pin"))
    (expect-text (test-id "slot-left") "WorkspacesWorkspacesApp3Write docsdocsidleFix testsrunningscratch")
    (click (role button :name "Write docs menu"))
    (expect-visible (role button :name "Unpin"))
    (press "Escape")
    (stub-http "pin" :url "/liton/v1/call" :status 200 :body "{\"Err\":{\"code\":\"Unavailable\",\"message\":\"the provider can't pin docs\"}}")
    (run-effect 4)
    (expect-text (test-id "slot-left") "WorkspacesWorkspacesApp3Fix testsrunningWrite docsdocsidlescratch")
    (expect-visible (text "the provider can't pin docs"))
    ; A workspace archived is gone at once, and stays gone once listed so.
    (expect-visible (role button :name "scratch"))
    (click (role button :name "scratch menu"))
    (click (role button :name "Archive"))
    (expect-absent (role button :name "scratch"))
    (stub-http "archive" :url "/liton/v1/call" :status 200 :body "{\"Ok\":\"Accepted\"}")
    (run-effect 5)
    (expect-absent (role button :name "scratch"))
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[]}")
    (run-effect 3)
(stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c2\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Running\",\"title\":\"Fix tests\",\"updated\":\"2026-01-01T10:00:00.000Z\",\"workspace\":{\"directory\":\"/src/app\",\"id\":\"w1\"}},{\"agent\":\"claude\",\"id\":\"s2\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Write docs\",\"updated\":\"2026-01-01T09:00:00.000Z\",\"workspace\":{\"directory\":\"/src/app\",\"id\":\"w2\"}}]}]},{\"capability\":\"attention.v1\",\"topic\":\"items\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspaces.v1\",\"topic\":\"list\",\"cursor\":\"l1\",\"events\":[{\"Listed\":{\"projects\":[{\"directory\":\"/src/app\",\"id\":\"p1\",\"name\":\"app\",\"provider\":\"mock\"}],\"workspaces\":[{\"branch\":{\"Branch\":\"main\"},\"changes\":\"Uncounted\",\"directory\":\"/src/app\",\"dirty\":false,\"id\":\"w1\",\"kind\":\"Checkout\",\"labels\":[],\"name\":\"main\",\"pinned\":false,\"project_id\":\"p1\",\"provider\":\"mock\",\"session_ids\":[\"s1\"],\"state\":\"Working\"},{\"branch\":{\"Branch\":\"docs\"},\"changes\":\"Uncounted\",\"directory\":\"/src/app\",\"dirty\":false,\"id\":\"w2\",\"kind\":\"Worktree\",\"labels\":[],\"name\":\"docs\",\"pinned\":false,\"project_id\":\"p1\",\"provider\":\"mock\",\"session_ids\":[\"s2\"],\"state\":\"Idle\"}]}}]}]}")
    (run-effect 6)
    (expect-text (test-id "slot-left") "WorkspacesWorkspacesApp2Fix testsrunningWrite docsdocsidle")
    ; A session archived is gone at once, and back with why if refused.
    (click (role button :name "Fix tests menu"))
    (click (role button :name "Archive"))
    (expect-absent (role button :name "Fix tests"))
    (stub-http "archive" :url "/liton/v1/call" :status 200 :body "{\"Ok\":{\"Rejected\":\"Fix tests is still running\"}}")
    (run-effect 7)
    (expect-visible (role button :name "Fix tests"))
    (expect-visible (text "Fix tests is still running"))
  )
)
