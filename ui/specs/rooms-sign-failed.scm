(test "Liton — a message to a signing room this browser can't sign stays with why, to retry"
  (setup
    (local-storage "liton.snapshot" "{\"version\":6,\"shell\":\"Tiling\",\"columns\":[{\"id\":\"column-1\",\"size\":1,\"tabbed\":false,\"active\":\"pane-1\",\"panes\":[{\"id\":\"pane-1\",\"widget\":\"rooms\",\"pinned\":\"\",\"options\":[]}]}],\"collapsed\":[],\"hidden\":[],\"theme\":\"\"}"))
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"rooms\",\"version\":1}],\"id\":\"relay\",\"name\":\"Relay\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[]}")
    (run-effect 2)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"rooms.v1\",\"topic\":\"rooms\",\"cursor\":\"r1\",\"events\":[{\"Rooms\":[{\"id\":\"dispatch\",\"provider\":\"relay\",\"name\":\"dispatch\",\"kind\":\"Channel\",\"private\":false,\"archived\":false,\"joined\":true,\"unread\":\"Unknown\",\"links\":[],\"me\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"signing\":true}]}]}]}")
    (run-effect 3)
    (answer-port 4 reply "\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"")
    (stub-http "bind" :url "/liton/v1/devices/key" :status 409 :body "this device has a key already")
    (run-effect 5)
    (click (role button :name "#dispatch"))
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"rooms.v1\",\"topic\":\"rooms\",\"cursor\":\"r1\",\"events\":[]},{\"capability\":\"rooms.v1\",\"topic\":\"messages/dispatch\",\"cursor\":\"0\",\"events\":[]},{\"capability\":\"rooms.v1\",\"topic\":\"members/dispatch\",\"cursor\":\"m1\",\"events\":[{\"Members\":[{\"id\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"provider\":\"relay\",\"name\":\"Dana\",\"kind\":\"Person\",\"role\":\"Admin\",\"presence\":\"Unknown\"}]}]}]}")
    (run-effect 6)
    (fill (label "Your message") "On it")
    (click (role button :name "Send to the room"))
    (answer-port 7 throw "IndexedDB is unavailable")
    (expect-text (test-id "room-sent-status") "Not sent: This browser couldn't sign it.")
    (click (role button :name "Retry"))
    (expect-text (test-id "room-sent-status") "Sending…")
    (expect-port-call 8 "liton/nostr/sign" "{\"content\":\"On it\",\"kind\":9,\"tags\":[[\"h\",\"dispatch\"]]}")
  )
)
