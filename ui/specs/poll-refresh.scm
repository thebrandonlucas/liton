(test "Liton — where the daemon offers a refresh, a timeline it has yet to fetch shows loading and asks for one at once, a poll follows each refresh, the tick refreshes in place of polling, and a timeline it kept shows at once while it refreshes"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"workspaces\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"refresh\":true,\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Write docs\"},{\"agent\":\"claude\",\"id\":\"s2\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Fix tests\"}]}]},{\"capability\":\"attention.v1\",\"topic\":\"items\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspaces.v1\",\"topic\":\"list\",\"cursor\":\"w1\",\"events\":[{\"Listed\":{\"projects\":[{\"directory\":\"/src/app\",\"id\":\"p1\",\"name\":\"app\",\"provider\":\"mock\"}],\"workspaces\":[{\"branch\":{\"Branch\":\"main\"},\"changes\":\"Uncounted\",\"directory\":\"/src/app\",\"dirty\":false,\"id\":\"w1\",\"kind\":\"Checkout\",\"labels\":[],\"name\":\"main\",\"pinned\":false,\"project_id\":\"p1\",\"provider\":\"mock\",\"session_ids\":[\"s1\",\"s2\"],\"state\":\"Idle\"}]}}]}]}")
    (run-effect 2)
    ; The daemon kept nothing of s1's timeline yet: loading, not empty, and a refresh goes at once.
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"refresh\":true,\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/s1\",\"cursor\":\"\",\"events\":[],\"refreshing\":true}]}")
    (run-effect 3)
    (expect-visible (role status :name "Loading"))
    (expect-pending-effects 1)
    ; Its answer polls at once, which brings the timeline.
    (stub-http "refresh" :url "/liton/v1/refresh" :status 200 :body "{}")
    (run-effect 4)
    (expect-pending-effects 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"refresh\":true,\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/s1\",\"cursor\":\"1\",\"events\":[{\"Entry\":{\"event\":{\"AgentMessage\":{\"text\":\"Docs written.\"}},\"sequence\":1}}]}]}")
    (run-effect 5)
    (expect-absent (role status :name "Loading"))
    (expect-visible (text "Docs written."))
    (expect-absent (role status :name "Refreshing"))
    (expect-pending-effects 0)
    ; The tick refreshes, and the poll follows the refresh.
    (tick-interval 1000)
    (expect-pending-effects 1)
    (stub-http "refresh" :url "/liton/v1/refresh" :status 200 :body "{}")
    (run-effect 6)
    (expect-pending-effects 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"refresh\":true,\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/s1\",\"cursor\":\"1\",\"events\":[]}]}")
    (run-effect 7)
    (expect-pending-effects 0)
    ; s2's timeline the daemon kept shows at once, refreshing until its provider was asked.
    (click (role tab :name "Fix tests"))
    (expect-pending-effects 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"refresh\":true,\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/s2\",\"cursor\":\"1\",\"events\":[{\"Entry\":{\"event\":{\"AgentMessage\":{\"text\":\"Tests fixed.\"}},\"sequence\":1}}],\"refreshing\":true}]}")
    (run-effect 8)
    (expect-visible (text "Tests fixed."))
    (expect-visible (role status :name "Refreshing"))
    (expect-pending-effects 1)
    (stub-http "refresh" :url "/liton/v1/refresh" :status 200 :body "{}")
    (run-effect 9)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"refresh\":true,\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/s2\",\"cursor\":\"2\",\"events\":[{\"Entry\":{\"event\":{\"AgentMessage\":{\"text\":\"And pushed.\"}},\"sequence\":2}}]}]}")
    (run-effect 10)
    (expect-visible (text "And pushed."))
    (expect-absent (role status :name "Refreshing"))
  )
)
