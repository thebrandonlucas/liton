(test "Liton — the inbox lists what needs you, then the latest first, marks what is unread, and opening an item reads it at once"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[{\"id\":\"attention\",\"name\":\"Attention\",\"offers\":{\"name\":\"attention\",\"version\":1},\"uses\":[{\"name\":\"chat\",\"version\":1}]}],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"codex\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Running\",\"title\":\"Refactor\"},{\"agent\":\"claude\",\"id\":\"s2\",\"provider\":\"mock\",\"status\":\"AwaitingPermission\",\"title\":\"Fix tests\"},{\"agent\":\"claude\",\"id\":\"s3\",\"provider\":\"mock\",\"status\":\"Finished\",\"title\":\"Write docs\"}]}]}]}")
    (run-effect 2)
    (click (role button :name "Settings"))
    (click (role button :name "Inbox preset"))
    (click (role button :name "Settings"))
    (expect-attr (test-id "slot-right") class "column slot slot-right tabbed collapsed")
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/s1\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"attention.v1\",\"topic\":\"items\",\"cursor\":\"i1\",\"events\":[{\"Items\":[{\"agent\":\"claude\",\"permissions\":[],\"provider\":\"mock\",\"session_id\":\"s2\",\"set_aside\":\"No\",\"signature\":\"NeedsYou 1\",\"state\":\"NeedsYou\",\"summary\":\"Can I?\",\"title\":\"Fix tests\",\"unread\":true,\"updated\":\"2026-01-01T09:00:00.000Z\"},{\"agent\":\"claude\",\"permissions\":[],\"provider\":\"mock\",\"session_id\":\"s3\",\"set_aside\":\"No\",\"signature\":\"Done 1\",\"state\":\"Done\",\"summary\":\"Docs written.\",\"title\":\"Write docs\",\"unread\":true,\"updated\":\"2026-01-01T09:05:00.000Z\"},{\"agent\":\"codex\",\"permissions\":[],\"provider\":\"mock\",\"session_id\":\"s1\",\"set_aside\":\"No\",\"signature\":\"Working 1\",\"state\":\"Working\",\"summary\":\"\",\"title\":\"Refactor\",\"unread\":false,\"updated\":\"2026-01-01T09:03:00.000Z\"},{\"agent\":\"claude\",\"permissions\":[],\"provider\":\"mock\",\"session_id\":\"s4\",\"set_aside\":\"No\",\"signature\":\"Idle 1\",\"state\":\"Idle\",\"summary\":\"\",\"title\":\"Scratch\",\"unread\":false,\"updated\":\"2026-01-01T08:00:00.000Z\"}]}]}]}")
    (run-effect 3)
    (expect-text (test-id "slot-left") "Inbox (1)RoomsInbox (1)2 unreadMark all readNeeds youFix testsclaudeneeds youCan I?Mark readSettleSnooze 1 hourLatestWrite docsclaudedoneDocs written.Mark readSettleSnooze 1 hourRefactorcodexworkingMark unreadSettleSnooze 1 hourScratchclaudeidleMark unreadSettleSnooze 1 hourRoomsThis widget needs rooms.v1, which no connected provider supplies. Connect one that does, and it fills in here.")
    (click (test-id "show-left"))
    (click (role button :name "Write docs"))
    ; Read before the daemon answers.
    (expect-text (test-id "session-title") "Write docs")
    (expect-attr (test-id "show-main") aria-pressed "true")
    (expect-visible (role button :name "Mark Write docs unread"))
    (expect-text (test-id "unread-count") "1 unread")
    (stub-http "seen" :url "/liton/v1/call" :status 200 :body "{\"Ok\":\"Accepted\"}")
    (run-effect 4)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]}]}")
    (run-effect 5)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/s3\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"attention.v1\",\"topic\":\"items\",\"cursor\":\"i2\",\"events\":[{\"Items\":[{\"agent\":\"claude\",\"permissions\":[],\"provider\":\"mock\",\"session_id\":\"s2\",\"set_aside\":\"No\",\"signature\":\"NeedsYou 1\",\"state\":\"NeedsYou\",\"summary\":\"Can I?\",\"title\":\"Fix tests\",\"unread\":true,\"updated\":\"2026-01-01T09:00:00.000Z\"},{\"agent\":\"claude\",\"permissions\":[],\"provider\":\"mock\",\"session_id\":\"s3\",\"set_aside\":\"No\",\"signature\":\"Done 1\",\"state\":\"Done\",\"summary\":\"Docs written.\",\"title\":\"Write docs\",\"unread\":false,\"updated\":\"2026-01-01T09:05:00.000Z\"},{\"agent\":\"codex\",\"permissions\":[],\"provider\":\"mock\",\"session_id\":\"s1\",\"set_aside\":\"No\",\"signature\":\"Working 1\",\"state\":\"Working\",\"summary\":\"\",\"title\":\"Refactor\",\"unread\":false,\"updated\":\"2026-01-01T09:03:00.000Z\"},{\"agent\":\"claude\",\"permissions\":[],\"provider\":\"mock\",\"session_id\":\"s4\",\"set_aside\":\"No\",\"signature\":\"Idle 1\",\"state\":\"Idle\",\"summary\":\"\",\"title\":\"Scratch\",\"unread\":false,\"updated\":\"2026-01-01T08:00:00.000Z\"}]}]}]}")
    (run-effect 6)
    (expect-text (test-id "unread-count") "1 unread")
    (click (role button :name "Mark all read"))
    (expect-text (test-id "unread-count") "All read")
    (stub-http "seen" :url "/liton/v1/call" :status 200 :body "{\"Err\":{\"code\":\"Unavailable\",\"message\":\"The daemon is busy.\"}}")
    (run-effect 7)
    (expect-text (test-id "unread-count") "1 unread")
    (expect-visible (text "The daemon is busy."))
    (click (role button :name "Mark Write docs unread"))
    (expect-text (test-id "unread-count") "2 unread")
    (expect-visible (role button :name "Mark Write docs read"))
  )
)
