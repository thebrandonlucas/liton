(test "Liton — the Changes pane lists the changed files, and a file picked shows at once, then its hunks with line numbers"
  (steps
    (stub-http "manifest" :url "/api/manifest" :status 200 :body "{\"protocol\":1,\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"workspace.git\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}]}")
    (run-effect 1)
    (stub-http "poll" :url "/api/chat/poll" :status 200 :body "{\"sessions\":[{\"agent\":\"claude\",\"id\":\"fix-auth\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Fix the login redirect\"}],\"timelines\":[{\"session_id\":\"fix-auth\",\"entries\":[]}]}")
    (run-effect 2)
    (stub-http "poll" :url "/api/chat/poll" :status 200 :body "{\"sessions\":[{\"agent\":\"claude\",\"id\":\"fix-auth\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Fix the login redirect\"}],\"timelines\":[{\"session_id\":\"fix-auth\",\"entries\":[]}]}")
    (run-effect 3)
    (stub-http "git" :url "/api/git/poll" :status 200 :body "{\"changes\":{\"Changed\":{\"files\":[{\"additions\":1,\"body\":\"Text\",\"change\":\"Modified\",\"deletions\":1,\"path\":\"src/Auth.roc\"}],\"fingerprint\":\"f1\",\"scope\":\"Uncommitted\"}},\"file\":\"NoFile\",\"status\":{\"Status\":{\"ahead\":1,\"base\":{\"Base\":\"main\"},\"behind\":0,\"branch\":{\"Branch\":\"fix-auth\"},\"dirty\":true,\"upstream\":\"NoUpstream\"}},\"workspace\":{\"Known\":{\"directory\":\"/w\",\"id\":\"/w\",\"kind\":\"Checkout\",\"name\":\"w\",\"provider\":\"mock\",\"repository_root\":\"/w\"}},\"commits\":[]}")
    (run-effect 4)
    (expect-visible (text "fix-auth"))
    (expect-visible (text "modified"))
    (expect-visible (text "+1 −1"))
    (click (role button :name "src/Auth.roc"))
    ; Picked before the daemon answers.
    (expect-attr (role button :name "src/Auth.roc") aria-pressed "true")
    (expect-visible (text "Loading…"))
    (expect-pending-effects 1)
    (stub-http "git" :url "/api/git/poll" :status 200 :body "{\"changes\":\"Unchanged\",\"file\":{\"Hunks\":{\"path\":\"src/Auth.roc\",\"hunks\":[{\"old_start\":40,\"old_count\":3,\"new_start\":40,\"new_count\":3,\"lines\":[{\"kind\":\"Context\",\"text\":\"login\",\"old_line\":40,\"new_line\":40},{\"kind\":\"Removed\",\"text\":\"go(login_page)\",\"old_line\":41,\"new_line\":0},{\"kind\":\"Added\",\"text\":\"go(came_from)\",\"old_line\":0,\"new_line\":41},{\"kind\":\"Context\",\"text\":\"start\",\"old_line\":42,\"new_line\":42}]}]}},\"status\":{\"Status\":{\"ahead\":1,\"base\":{\"Base\":\"main\"},\"behind\":0,\"branch\":{\"Branch\":\"fix-auth\"},\"dirty\":true,\"upstream\":\"NoUpstream\"}},\"workspace\":{\"Known\":{\"directory\":\"/w\",\"id\":\"/w\",\"kind\":\"Checkout\",\"name\":\"w\",\"provider\":\"mock\",\"repository_root\":\"/w\"}},\"commits\":[]}")
    (run-effect 5)
    (expect-absent (text "Loading…"))
    (expect-visible (text "@@ -40,3 +40,3 @@"))
    (expect-visible (text "- go(login_page)"))
    (expect-visible (text "+ go(came_from)"))
    (expect-visible (text "42"))
  )
)
