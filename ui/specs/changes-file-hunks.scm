(test "Liton — the Changes pane lists the changed files, and a file picked shows at once, then its hunks with line numbers"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"workspace.git\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"fix-auth\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Fix the login redirect\"}]}]}]}")
    (run-effect 2)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/fix-auth\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"changes/fix-auth/Uncommitted\",\"cursor\":\"g1\",\"events\":[{\"Changes\":{\"workspace\":{\"Known\":{\"directory\":\"/w\",\"id\":\"/w\",\"kind\":\"Checkout\",\"name\":\"w\",\"provider\":\"mock\",\"repository_root\":\"/w\"}},\"status\":{\"Status\":{\"ahead\":1,\"base\":{\"Base\":\"main\"},\"behind\":0,\"branch\":{\"Branch\":\"fix-auth\"},\"dirty\":true,\"upstream\":\"NoUpstream\"}},\"changes\":{\"scope\":\"Uncommitted\",\"fingerprint\":\"f1\",\"files\":[{\"additions\":1,\"body\":\"Text\",\"change\":\"Modified\",\"deletions\":1,\"path\":\"src/Auth.roc\"}]},\"commits\":[]}}]}]}")
    (run-effect 3)
    (expect-visible (text "fix-auth"))
    (expect-visible (text "modified"))
    (expect-visible (text "+1 −1"))
    (click (role button :name "src/Auth.roc"))
    ; Picked before the daemon answers, and asked for at once.
    (expect-attr (role button :name "src/Auth.roc") aria-pressed "true")
    (expect-visible (text "Loading…"))
    (expect-pending-effects 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/fix-auth\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"changes/fix-auth/Uncommitted\",\"cursor\":\"g1\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"file/fix-auth/Uncommitted/src%2FAuth.roc\",\"cursor\":\"h1\",\"events\":[{\"File\":{\"path\":\"src/Auth.roc\",\"hunks\":[{\"old_start\":40,\"old_count\":3,\"new_start\":40,\"new_count\":3,\"lines\":[{\"kind\":\"Context\",\"text\":\"login\",\"old_line\":40,\"new_line\":40},{\"kind\":\"Removed\",\"text\":\"go(login_page)\",\"old_line\":41,\"new_line\":0},{\"kind\":\"Added\",\"text\":\"go(came_from)\",\"old_line\":0,\"new_line\":41},{\"kind\":\"Context\",\"text\":\"start\",\"old_line\":42,\"new_line\":42}]}]}}]}]}")
    (run-effect 4)
    (expect-absent (text "Loading…"))
    (expect-visible (text "@@ -40,3 +40,3 @@"))
    (expect-visible (text "- go(login_page)"))
    (expect-visible (text "+ go(came_from)"))
    (expect-visible (text "42"))
  )
)
