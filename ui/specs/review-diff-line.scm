(test "Liton — a removed line of a diff in Changes takes a comment on the old side, and an added one on the new"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"workspace.git\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"},{\"capabilities\":[{\"name\":\"review\",\"version\":1}],\"id\":\"review\",\"name\":\"Review\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"fix-auth\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Fix the login redirect\"}]}]}]}")
    (run-effect 2)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/fix-auth\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"changes/fix-auth/Uncommitted\",\"cursor\":\"g1\",\"events\":[{\"Changes\":{\"workspace\":{\"Known\":{\"directory\":\"/w\",\"id\":\"/w\",\"kind\":\"Checkout\",\"name\":\"w\",\"provider\":\"mock\",\"repository_root\":\"/w\"}},\"status\":{\"Status\":{\"ahead\":1,\"base\":{\"Base\":\"main\"},\"behind\":0,\"branch\":{\"Branch\":\"fix-auth\"},\"dirty\":true,\"upstream\":\"NoUpstream\"}},\"changes\":{\"scope\":\"Uncommitted\",\"fingerprint\":\"f1\",\"files\":[{\"additions\":1,\"body\":\"Text\",\"change\":\"Modified\",\"deletions\":1,\"path\":\"src/Auth.roc\"}]},\"commits\":[]}}]},{\"capability\":\"review.v1\",\"topic\":\"threads/fix-auth\",\"cursor\":\"r0\",\"events\":[{\"Threads\":{\"round\":0,\"next\":1,\"threads\":[],\"comments\":[]}}]}]}")
    (run-effect 3)
    (click (role button :name "src/Auth.roc"))
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/fix-auth\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"changes/fix-auth/Uncommitted\",\"cursor\":\"g1\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"file/fix-auth/Uncommitted/src%2FAuth.roc\",\"cursor\":\"h1\",\"events\":[{\"File\":{\"path\":\"src/Auth.roc\",\"hunks\":[{\"old_start\":40,\"old_count\":3,\"new_start\":50,\"new_count\":3,\"lines\":[{\"kind\":\"Context\",\"text\":\"login\",\"old_line\":40,\"new_line\":50},{\"kind\":\"Removed\",\"text\":\"go(login_page)\",\"old_line\":41,\"new_line\":0},{\"kind\":\"Added\",\"text\":\"go(came_from)\",\"old_line\":0,\"new_line\":51},{\"kind\":\"Context\",\"text\":\"start\",\"old_line\":42,\"new_line\":52}]}]}}]},{\"capability\":\"review.v1\",\"topic\":\"threads/fix-auth\",\"cursor\":\"r0\",\"events\":[]}]}")
    (run-effect 4)
    (expect-visible (text "@@ -40,3 +50,3 @@"))
    (click (role button :name "41"))
    (expect-visible (text "Comment on src/Auth.roc:41, removed"))
    (click (role button :name "51"))
    (expect-visible (text "Comment on src/Auth.roc:51"))
    (fill (label "Your comment") "Where does came_from come from?")
    (click (role button :name "Comment"))
    (expect-pending-effects 1)
    (expect-text (test-id "comment-state") "draft")
    (expect-visible (text "Where does came_from come from?"))
  )
)
