(test "Liton — a Board's New ticket names a new project, then a title, each shown at once until the daemon has it, and a ticket it refuses is undone with why"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"tickets\",\"version\":1}],\"id\":\"tickets\",\"name\":\"Tickets\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]}]}")
    (run-effect 2)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]}]}")
    (run-effect 3)
    (press "7")
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"tickets.v1\",\"topic\":\"list\",\"cursor\":\"l1\",\"events\":[{\"Tickets\":{\"sources\":[],\"tickets\":[]}}]},{\"capability\":\"tickets.v1\",\"topic\":\"links\",\"cursor\":\"k1\",\"events\":[{\"Links\":[]}]}]}")
    (run-effect 4)
    ; With no project yet, New ticket asks for one, shown at once.
    (click (role button :name "New ticket"))
    (fill (label "Project name") "liton")
    (click (role button :name "Create project"))
    (expect-visible (label "Title"))
    (expect-absent (label "Project name"))
    (stub-http "project" :url "/liton/v1/call" :status 200 :body "{\"Ok\":{\"Created\":{\"id\":\"tickets/p1\",\"key\":\"LIT\"}}}")
    (run-effect 5)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"tickets.v1\",\"topic\":\"list\",\"cursor\":\"l2\",\"events\":[{\"Tickets\":{\"sources\":[{\"id\":\"tickets/p1\",\"provider\":\"tickets\",\"name\":\"liton\",\"url\":\"\",\"people\":[],\"statuses\":[{\"id\":\"backlog\",\"name\":\"Backlog\",\"kind\":\"Open\"},{\"id\":\"todo\",\"name\":\"Todo\",\"kind\":\"Open\"},{\"id\":\"done\",\"name\":\"Done\",\"kind\":\"Done\"}]}],\"tickets\":[]}}]},{\"capability\":\"tickets.v1\",\"topic\":\"links\",\"cursor\":\"k1\",\"events\":[]}]}")
    (run-effect 6)
    (expect-value (label "Project") "tickets/p1")
    ; An empty title sends nothing and says why.
    (click (role button :name "Create"))
    (expect-visible (text "Give the ticket a title."))
    ; A ticket shows at once, and refused, it goes again, with why.
    (fill (label "Title") "Drop images in the composer")
    (click (role button :name "Create"))
    (expect-visible (text "Drop images in the composer"))
    (expect-absent (label "Title"))
    (stub-http "ticket" :url "/liton/v1/call" :status 200 :body "{\"Err\":{\"code\":\"BadRequest\",\"message\":\"there is no project tickets/p1\"}}")
    (run-effect 7)
    (expect-absent (text "Drop images in the composer"))
    (expect-visible (text "there is no project tickets/p1"))
  )
)
