(test "Liton — a browser the daemon doesn't answer as it isn't paired shows the pair screen, which shows Pairing… at once, says why a code fails, and once paired asks for the manifest again"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 401 :body "this device isn't paired with the daemon")
    (run-effect 1)
    (expect-visible (text "Pair this browser"))
    (click (role button :name "Pair"))
    (expect-text (test-id "pair-failed") "Type the pairing code first.")
    (expect-pending-effects 1)
    (fill (label "Pairing code") "abcd-efgh")
    (click (role button :name "Pair"))
    ; Pairing at once, before the daemon answers.
    (expect-pending-effects 2)
    (expect-visible (role button :name "Pairing…"))
    (stub-http "pair" :url "/liton/v1/pair" :status 401 :body "that pairing code is wrong, used or expired")
    (run-effect 3)
    (expect-text (test-id "pair-failed") "That code is wrong, used or expired. Make a new one.")
    (expect-visible (role button :name "Pair"))
    (fill (label "Pairing code") "WXYZ-2345")
    (click (role button :name "Pair"))
    (expect-visible (role button :name "Pairing…"))
    (stub-http "pair" :url "/liton/v1/pair" :status 200 :body "{\"device\":{\"id\":\"d1\",\"name\":\"Browser\"}}")
    (run-effect 4)
    (expect-absent (text "Pair this browser"))
    ; Paired, the manifest is asked for again.
    (expect-pending-effects 2)
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 5)
    (expect-absent (text "Pair this browser"))
  )
)
