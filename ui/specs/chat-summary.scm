(test "Liton — a chat shows its session's summary over the timeline, Goal, Done and Now, which its heading folds and opens at once, and its Summary option folds or hides; a session without one shows none"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Fix tests\",\"summary\":{\"at\":\"2026-01-01T09:00:09.000Z\",\"done\":\"Found the test that expected UTC.\",\"goal\":\"Make the test suite pass.\",\"now\":\"Waiting for your review.\"}}]}]}]}")
    (run-effect 2)
    (expect-text (test-id "summary") "SummaryGoalMake the test suite pass.DoneFound the test that expected UTC.NowWaiting for your review.")
    (expect-text (test-id "summary-goal") "Make the test suite pass.")
    (click (role button :name "Summary"))
    (expect-attr (role button :name "Summary") aria-expanded "false")
    (expect-absent (test-id "summary-goal"))
    (click (role button :name "Summary"))
    (expect-attr (role button :name "Summary") aria-expanded "true")
    (expect-text (test-id "summary-now") "Waiting for your review.")
    (click (role button :name "Settings"))
    (expect-value (label "Summary") "Open")
    (select-option (label "Summary") "Folded")
    (expect-absent (test-id "summary-goal"))
    (select-option (label "Summary") "Hidden")
    (expect-absent (test-id "summary"))
    (select-option (label "Summary") "Open")
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c2\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Fix tests\"}]}]}]}")
    (run-effect 3)
    (expect-absent (test-id "summary"))
  )
)
