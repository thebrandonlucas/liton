(test "Liton — the Review view's bar counts the comments of its threads, and its arrows focus the next or previous thread in the order of its files, scrolled to and its file in view"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"workspace.git\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"},{\"capabilities\":[{\"name\":\"review\",\"version\":1}],\"id\":\"review\",\"name\":\"Review\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"fix-auth\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Fix the login redirect\"}]}]}]}")
    (run-effect 2)
    (press "6")
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/fix-auth\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"changes/fix-auth/Uncommitted\",\"cursor\":\"g-f1\",\"events\":[{\"Changes\":{\"workspace\":{\"Known\":{\"directory\":\"/w\",\"id\":\"/w\",\"kind\":\"Checkout\",\"name\":\"w\",\"provider\":\"mock\",\"repository_root\":\"/w\"}},\"status\":{\"Status\":{\"ahead\":1,\"base\":{\"Base\":\"main\"},\"behind\":0,\"branch\":{\"Branch\":\"fix-auth\"},\"dirty\":true,\"upstream\":\"NoUpstream\"}},\"changes\":{\"scope\":\"Uncommitted\",\"fingerprint\":\"f1\",\"files\":[{\"additions\":1,\"body\":\"Text\",\"change\":\"Modified\",\"deletions\":1,\"path\":\"src/Auth.roc\"},{\"additions\":2,\"body\":\"Text\",\"change\":\"Added\",\"deletions\":0,\"path\":\"docs/notes.md\"}]},\"commits\":[]}}]},{\"capability\":\"review.v1\",\"topic\":\"threads/fix-auth\",\"cursor\":\"r1\",\"events\":[{\"Threads\":{\"round\":1,\"next\":6,\"threads\":[{\"id\":\"t4\",\"outdated\":false,\"resolved\":false,\"anchor\":{\"path\":\"docs/notes.md\",\"scope\":\"Uncommitted\",\"side\":\"New\",\"start_line\":2,\"end_line\":2,\"quote\":\"Redirects go back.\"},\"comments\":[{\"id\":\"c3\",\"author\":\"Me\",\"text\":\"Back where?\",\"state\":{\"Sent\":1}},{\"id\":\"c5\",\"author\":\"Agent\",\"text\":\"To the page asked for.\",\"state\":{\"Sent\":1}}]},{\"id\":\"t2\",\"outdated\":false,\"resolved\":false,\"anchor\":{\"path\":\"src/Auth.roc\",\"scope\":\"Uncommitted\",\"side\":\"New\",\"start_line\":51,\"end_line\":51,\"quote\":\"go(came_from)\"},\"comments\":[{\"id\":\"c1\",\"author\":\"Me\",\"text\":\"Where does came_from come from?\",\"state\":{\"Sent\":1}}]}],\"comments\":[]}}]}]}")
    (run-effect 3)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/fix-auth\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"changes/fix-auth/Uncommitted\",\"cursor\":\"g-f1\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"file/fix-auth/Uncommitted/src%2FAuth.roc\",\"cursor\":\"h1\",\"events\":[{\"File\":{\"path\":\"src/Auth.roc\",\"hunks\":[{\"old_start\":40,\"old_count\":3,\"new_start\":50,\"new_count\":3,\"lines\":[{\"kind\":\"Context\",\"text\":\"login\",\"old_line\":40,\"new_line\":50},{\"kind\":\"Removed\",\"text\":\"go(login_page)\",\"old_line\":41,\"new_line\":0},{\"kind\":\"Added\",\"text\":\"go(came_from)\",\"old_line\":0,\"new_line\":51},{\"kind\":\"Context\",\"text\":\"start\",\"old_line\":42,\"new_line\":52}]}]}}]},{\"capability\":\"workspace.git.v1\",\"topic\":\"file/fix-auth/Uncommitted/docs%2Fnotes.md\",\"cursor\":\"h1\",\"events\":[{\"File\":{\"path\":\"docs/notes.md\",\"hunks\":[{\"old_start\":0,\"old_count\":0,\"new_start\":1,\"new_count\":2,\"lines\":[{\"kind\":\"Added\",\"text\":\"# Notes\",\"old_line\":0,\"new_line\":1},{\"kind\":\"Added\",\"text\":\"Redirects go back.\",\"old_line\":0,\"new_line\":2}]}]}}]},{\"capability\":\"review.v1\",\"topic\":\"threads/fix-auth\",\"cursor\":\"r1\",\"events\":[]}]}")
    (run-effect 4)
    (expect-visible (text "To the page asked for."))
    (expect-text (test-id "comment-count") "3 comments")
    ; In the order of the files and lines: src/Auth.roc's first, then round again.
    (click (role button :name "Next comment"))
    (expect-attr (test-id "comment-c1") class "comment last focused")
    (expect-scroll 1 (test-id "comment-c1") into-view)
    (expect-attr (role button :name "src/Auth.roc") aria-current "true")
    (click (role button :name "Next comment"))
    (expect-attr (test-id "comment-c3") class "comment focused")
    (expect-attr (test-id "comment-c1") class "comment last")
    (expect-attr (role button :name "docs/notes.md") aria-current "true")
    (click (role button :name "Next comment"))
    (expect-attr (test-id "comment-c1") class "comment last focused")
    (click (role button :name "Previous comment"))
    (expect-attr (test-id "comment-c3") class "comment focused")
  )
)
