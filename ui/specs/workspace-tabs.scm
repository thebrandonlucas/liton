(test "Liton — where Workspaces lists sessions as tabs, the main area shows the workspace picked as tabs of its sessions, the one shown last remembered for each workspace, with the diff opened as a tab that closes, under a header naming it, whose menu, as + does, starts an agent there"
  (setup
    (local-storage "liton.snapshot" "{\"collapsed\":[],\"grid\":{\"columns\":[1,1,1],\"rows\":[1],\"tiles\":[{\"active\":\"pane-1\",\"bottom\":1,\"id\":\"tile-1\",\"left\":0,\"panes\":[{\"id\":\"pane-1\",\"options\":[{\"key\":\"sessions\",\"value\":\"Tabs\"}],\"pinned\":\"\",\"widget\":\"workspaces\"}],\"right\":1,\"top\":0},{\"active\":\"pane-2\",\"bottom\":1,\"id\":\"tile-2\",\"left\":1,\"panes\":[{\"id\":\"pane-2\",\"options\":[],\"pinned\":\"\",\"widget\":\"chat\"},{\"id\":\"pane-8\",\"options\":[],\"pinned\":\"\",\"widget\":\"ticket\"}],\"right\":2,\"top\":0},{\"active\":\"pane-3\",\"bottom\":1,\"id\":\"tile-3\",\"left\":2,\"panes\":[{\"id\":\"pane-3\",\"options\":[],\"pinned\":\"\",\"widget\":\"changes\"}],\"right\":3,\"top\":0}]},\"hidden\":[\"pane-8\"],\"shell\":\"Workbench\",\"theme\":\"\",\"version\":8}"))
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"workspaces\",\"version\":1},{\"name\":\"workspace.git\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Fix tests\",\"updated\":\"2026-01-01T10:00:00.000Z\",\"workspace\":{\"directory\":\"/src/app\",\"id\":\"w1\"}},{\"agent\":\"claude\",\"id\":\"s2\",\"provider\":\"mock\",\"status\":\"AwaitingPermission\",\"title\":\"Write docs\",\"updated\":\"2026-01-01T09:00:00.000Z\",\"workspace\":{\"directory\":\"/src/app\",\"id\":\"w1\"}},{\"agent\":\"claude\",\"id\":\"s3\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Draft notes\",\"updated\":\"2026-01-01T11:00:00.000Z\",\"workspace\":{\"directory\":\"/src/app\",\"id\":\"w2\"}}]}]},{\"capability\":\"attention.v1\",\"topic\":\"items\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspaces.v1\",\"topic\":\"list\",\"cursor\":\"l1\",\"events\":[{\"Listed\":{\"projects\":[{\"directory\":\"/src/app\",\"id\":\"p1\",\"name\":\"app\",\"provider\":\"mock\"}],\"workspaces\":[{\"branch\":{\"Branch\":\"main\"},\"changes\":\"Uncounted\",\"directory\":\"/src/app\",\"dirty\":false,\"id\":\"w1\",\"kind\":\"Checkout\",\"labels\":[],\"name\":\"main\",\"pinned\":false,\"project_id\":\"p1\",\"provider\":\"mock\",\"session_ids\":[\"s1\",\"s2\"],\"state\":\"NeedsYou\"},{\"branch\":{\"Branch\":\"notes\"},\"changes\":\"Uncounted\",\"directory\":\"/src/app\",\"dirty\":false,\"id\":\"w2\",\"kind\":\"Worktree\",\"labels\":[],\"name\":\"notes\",\"pinned\":false,\"project_id\":\"p1\",\"provider\":\"mock\",\"session_ids\":[\"s3\"],\"state\":\"Idle\"}]}}]}]}")
    (run-effect 2)
    ; A workspace of two sessions is one row; picked, it shows the one that needs you.
    (expect-absent (role button :name "Fix tests") :never-drawn)
    (click (role button :name "main"))
    (expect-text (test-id "session-title") "Write docs")
    ; Its header names it and its project.
    (expect-text (test-id "workspace-title") "main")
    (expect-visible (text "app"))
    (expect-attr (role tab :name "Write docs") aria-selected "true")
    (expect-attr (role tab :name "Fix tests") aria-selected "false")
    (click (role tab :name "Fix tests"))
    (expect-text (test-id "session-title") "Fix tests")
    (expect-attr (role tab :name "Fix tests") aria-selected "true")
    ; Another workspace shows its own tabs, and coming back shows the tab left.
    (click (role button :name "Draft notes"))
    (expect-text (test-id "session-title") "Draft notes")
    (expect-text (test-id "workspace-title") "notes")
    (expect-absent (role tab :name "Fix tests"))
    (click (role button :name "main"))
    (expect-text (test-id "session-title") "Fix tests")
    ; A diff opened in the main area is a tab of the workspace.
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]}]}")
    (run-effect 3)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/s1\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"changes/workspace:w1/Uncommitted\",\"cursor\":\"g1\",\"events\":[{\"Changes\":{\"workspace\":{\"Known\":{\"directory\":\"/src/app\",\"id\":\"w1\",\"kind\":\"Checkout\",\"name\":\"main\",\"provider\":\"mock\",\"repository_root\":\"/src/app\"}},\"status\":{\"Status\":{\"ahead\":0,\"base\":{\"Base\":\"main\"},\"behind\":0,\"branch\":{\"Branch\":\"main\"},\"dirty\":true,\"upstream\":\"NoUpstream\"}},\"changes\":{\"scope\":\"Uncommitted\",\"fingerprint\":\"f1\",\"files\":[{\"additions\":1,\"body\":\"Text\",\"change\":\"Modified\",\"deletions\":1,\"path\":\"src/Auth.roc\"}]},\"commits\":[]}}]}]}")
    (run-effect 4)
    (click (role button :name "src/Auth.roc"))
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/s1\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"changes/workspace:w1/Uncommitted\",\"cursor\":\"g1\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"file/workspace:w1/Uncommitted/src%2FAuth.roc\",\"cursor\":\"h1\",\"events\":[{\"File\":{\"path\":\"src/Auth.roc\",\"hunks\":[{\"old_start\":40,\"old_count\":2,\"new_start\":40,\"new_count\":2,\"lines\":[{\"kind\":\"Removed\",\"text\":\"go(login_page)\",\"old_line\":40,\"new_line\":0},{\"kind\":\"Added\",\"text\":\"go(came_from)\",\"old_line\":0,\"new_line\":40}]}]}}]}]}")
    (run-effect 5)
    (click (role button :name "Open in main area"))
    (expect-attr (role tab :name "Diff") aria-selected "true")
    (expect-visible (text "@@ -40,2 +40,2 @@"))
    (click (role tab :name "Fix tests"))
    (expect-visible (label "Message"))
    (expect-attr (role tab :name "Diff") aria-selected "false")
    (click (role button :name "Draft notes"))
    (expect-absent (role tab :name "Diff"))
    (click (role button :name "main"))
    (click (role tab :name "Diff"))
    (expect-visible (text "@@ -40,2 +40,2 @@"))
    (click (role button :name "Close Diff"))
    (expect-absent (role tab :name "Diff"))
    (expect-visible (label "Message"))
    ; + opens the form to start an agent in the workspace, as its header's menu does.
    (click (role button :name "New agent in this workspace"))
    (expect-visible (text "New agent in main"))
    (click (role button :name "Cancel"))
    (expect-absent (text "New agent in main"))
    (click (role button :name "Workspace menu"))
    (click (role button :name "New agent"))
    (expect-visible (text "New agent in main"))
  )
)
