(test "Liton — while the agent works, the composer says a message steers the turn it is working on, and sends it at once as sending; once idle, it messages the agent"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Running\",\"title\":\"Fix tests\",\"model\":\"claude-opus-4\",\"workspace\":{\"directory\":\"/src/liton\"},\"branch\":\"main\"}]}]}]}")
    (run-effect 2)
    (expect-attr (label "Message") placeholder "Steer: add to the turn it is working on")
    (expect-visible (role button :name "Stop"))
    (fill (label "Message") "Check the docs too")
    (press (label "Message") "Enter")
    (expect-text (test-id "sent-status") "Sending…")
    (expect-value (label "Message") "")
    (stub-http "send" :url "/liton/v1/call" :status 200 :body "{\"Ok\":\"Accepted\"}")
    (run-effect 4)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c2\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Fix tests\",\"model\":\"claude-opus-4\",\"workspace\":{\"directory\":\"/src/liton\"},\"branch\":\"main\"}]}]}]}")
    (run-effect 3)
    (expect-attr (label "Message") placeholder "Message the agent")
  )
)
