(test "Liton — a chat pane showing the latest shows its session's status and where it works over its latest activity, with Show the whole chat, Snooze and Rename, each at once"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"protocol\":1,\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"topics\":[],\"transformers\":[{\"id\":\"attention\",\"name\":\"Attention\",\"offers\":{\"name\":\"attention\",\"version\":1},\"uses\":[{\"name\":\"chat\",\"version\":1}]}]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"AwaitingPermission\",\"title\":\"Fix tests\",\"workspace\":{\"directory\":\"/src/app\",\"id\":\"w1\"}}]}],\"topic\":\"sessions\"},{\"capability\":\"attention.v1\",\"cursor\":\"i1\",\"events\":[{\"Items\":[{\"agent\":\"claude\",\"permissions\":[],\"provider\":\"mock\",\"session_id\":\"s1\",\"set_aside\":\"No\",\"signature\":\"NeedsYou 1\",\"state\":\"NeedsYou\",\"summary\":\"\",\"title\":\"Fix tests\",\"unread\":false,\"updated\":\"\"}]}],\"topic\":\"items\"}]}")
    (run-effect 2)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"cursor\":\"c1\",\"events\":[],\"topic\":\"sessions\"},{\"capability\":\"chat.v1\",\"cursor\":\"10\",\"events\":[{\"Entry\":{\"event\":{\"AgentMessage\":{\"text\":\"Said one\"}},\"sequence\":1}},{\"Entry\":{\"event\":{\"AgentMessage\":{\"text\":\"Said two\"}},\"sequence\":2}},{\"Entry\":{\"event\":{\"AgentMessage\":{\"text\":\"Said three\"}},\"sequence\":3}},{\"Entry\":{\"event\":{\"AgentMessage\":{\"text\":\"Said four\"}},\"sequence\":4}},{\"Entry\":{\"event\":{\"AgentMessage\":{\"text\":\"Said five\"}},\"sequence\":5}},{\"Entry\":{\"event\":{\"AgentMessage\":{\"text\":\"Said six\"}},\"sequence\":6}},{\"Entry\":{\"event\":{\"AgentMessage\":{\"text\":\"Said seven\"}},\"sequence\":7}},{\"Entry\":{\"event\":{\"AgentMessage\":{\"text\":\"Said eight\"}},\"sequence\":8}},{\"Entry\":{\"event\":{\"AgentMessage\":{\"text\":\"Said nine\"}},\"sequence\":9}},{\"Entry\":{\"event\":{\"AgentMessage\":{\"text\":\"Said ten\"}},\"sequence\":10}}],\"topic\":\"timeline/s1\"}]}")
    (run-effect 3)
    (expect-visible (text "Said one"))
    (expect-visible (text "Said two"))
    (expect-document-title "(1) liton")
    (click (role button :name "Settings"))
    (select-option (label "Show") "Latest")
    (click (role button :name "Settings"))
    (expect-text (test-id "overview-status") "running")
    (expect-absent (text "Said two"))
    (expect-visible (text "Said three"))
    (expect-visible (text "Said ten"))
    (click (role button :name "Show the whole chat"))
    (expect-visible (text "Said one"))
    (click (role button :name "Show the latest only"))
    (expect-absent (text "Said one"))
    (click (role button :name "Snooze"))
    (expect-document-title "liton")
    (click (role button :name "Rename"))
    (fill (label "New name") "Fix the tests")
    (press (label "New name") "Enter")
    (expect-text (test-id "session-title") "Fix the tests")
  )
)
