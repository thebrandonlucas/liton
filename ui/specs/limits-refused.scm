(test "Liton — past its session's context limit, a chat says so above its composer and offers Compact and Start fresh, which opens a new agent of its kind in its workspace, and a message the daemon refuses says why in place"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"workspaces\",\"version\":1},{\"name\":\"usage\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[{\"id\":\"limits\",\"name\":\"Limits\",\"offers\":{\"name\":\"limits\",\"version\":1},\"uses\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"usage\",\"version\":1}]}],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Fix tests\",\"workspace\":{\"directory\":\"/src/app\",\"id\":\"w1\"},\"usage\":{\"context_used\":170000,\"context_max\":200000}}]}]},{\"capability\":\"attention.v1\",\"topic\":\"items\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspaces.v1\",\"topic\":\"list\",\"cursor\":\"l1\",\"events\":[{\"Listed\":{\"projects\":[{\"directory\":\"/src/app\",\"id\":\"p1\",\"name\":\"app\",\"provider\":\"mock\"}],\"workspaces\":[{\"branch\":{\"Branch\":\"main\"},\"changes\":\"Uncounted\",\"directory\":\"/src/app\",\"dirty\":false,\"id\":\"w1\",\"kind\":\"Checkout\",\"labels\":[],\"name\":\"main\",\"pinned\":false,\"project_id\":\"p1\",\"provider\":\"mock\",\"session_ids\":[\"s1\"],\"state\":\"Idle\"}]}}]},{\"capability\":\"chat.v1\",\"topic\":\"agents\",\"cursor\":\"a1\",\"events\":[{\"Agents\":[{\"agent\":\"claude\",\"provider\":\"mock\"},{\"agent\":\"codex\",\"provider\":\"mock\"}]}]}]}")
    (run-effect 2)
    (expect-absent (test-id "limit-bar"))
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"limits.v1\",\"topic\":\"status\",\"cursor\":\"s1\",\"events\":[{\"Limits\":{\"limits\":[{\"scope\":\"Default\",\"percent\":80}],\"sessions\":[{\"session_id\":\"s1\",\"used_pct\":85,\"limit_pct\":80,\"state\":\"Over\"}],\"weeks\":[],\"five_hours\":[]}}]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/s1\",\"cursor\":\"1\",\"events\":[{\"Entry\":{\"event\":{\"StatusChanged\":\"Idle\"},\"sequence\":1}}]}]}")
    (run-effect 3)
    (expect-text (test-id "limit-bar") "Over its context limit: 85% of 80%. New messages are refused until you compact it or start fresh.CompactStart fresh")
    (fill (label "Message") "Go on")
    (click (role button :name "Send"))
    (expect-text (test-id "sent-status") "Sending…")
    (stub-http "send" :url "/liton/v1/call" :status 200 :body "{\"Err\":{\"code\":\"Refused\",\"message\":\"the session is over its context limit (85% of 80%): compact or start fresh\"}}")
    (run-effect 4)
    (expect-text (test-id "sent-status") "Not sent: the session is over its context limit (85% of 80%): compact or start fresh")
    (click (role button :name "Start fresh"))
    (expect-value (label "Agent") "claude")
    (expect-visible (role button :name "Start"))
  )
)
