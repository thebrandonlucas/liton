(test "Liton — Settings' Usage & limits shows each account's windows with how much is used and when each resets, Refresh asks again, shown at once, and the weekly and default limits' sliders set them at once, the week's bar turning amber or red, back with why if refused"
  (setup (initial-time "2026-01-02T10:00:00Z"))
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"usage\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[{\"id\":\"limits\",\"name\":\"Limits\",\"offers\":{\"name\":\"limits\",\"version\":1},\"uses\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"usage\",\"version\":1}]}],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[]}")
    (run-effect 2)
    (click (role button :name "Settings"))
    (click (role button :name "Usage & limits"))
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[]}]},{\"capability\":\"limits.v1\",\"topic\":\"status\",\"cursor\":\"s1\",\"events\":[{\"Limits\":{\"limits\":[],\"sessions\":[],\"weeks\":[{\"provider\":\"mock\",\"source\":\"claude\",\"account\":\"me@example.com\",\"used_pct\":85,\"state\":\"Ok\",\"resets_at\":\"2026-01-04T10:00:00.000Z\"}],\"five_hours\":[]}}]}]}")
    (run-effect 3)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"usage.v1\",\"topic\":\"reports\",\"cursor\":\"r1\",\"events\":[{\"Reports\":[{\"provider\":\"mock\",\"source\":\"claude\",\"account\":\"me@example.com\",\"plan\":\"Max\",\"status\":\"Available\",\"windows\":[{\"id\":\"five_hour\",\"label\":\"5-hour\",\"short\":\"5h\",\"used_pct\":12.4},{\"id\":\"weekly\",\"label\":\"Weekly\",\"short\":\"wk\",\"used_pct\":85,\"resets_at\":\"2026-01-04T10:00:00.000Z\"}],\"balances\":[]},{\"provider\":\"mock\",\"source\":\"codex\",\"account\":\"\",\"plan\":\"\",\"status\":{\"Unavailable\":\"the login expired\"},\"windows\":[],\"balances\":[]}]}]}]}")
    (run-effect 4)
    (expect-visible (text "claude · me@example.com · Max"))
    (expect-visible (text "5-hour"))
    (expect-visible (text "12%"))
    (expect-visible (text "85% · resets in 2d"))
    (expect-visible (text "the login expired"))
    (expect-text (test-id "weekly-limit") "No limit")
    ; The weekly limit shows at once, and the week's bar turns amber.
    (change (label "Weekly limit") "90")
    (expect-text (test-id "weekly-limit") "90% · saving…")
    (stub-http "limit" :url "/liton/v1/call" :status 200 :body "{\"Ok\":\"Accepted\"}")
    (run-effect 5)
    (expect-text (test-id "weekly-limit") "90% · saving…")
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"usage.v1\",\"topic\":\"reports\",\"cursor\":\"r1\",\"events\":[]},{\"capability\":\"limits.v1\",\"topic\":\"status\",\"cursor\":\"s2\",\"events\":[{\"Limits\":{\"limits\":[{\"scope\":\"Week\",\"percent\":90}],\"sessions\":[],\"weeks\":[{\"provider\":\"mock\",\"source\":\"claude\",\"account\":\"me@example.com\",\"used_pct\":85,\"limit_pct\":90,\"state\":\"Near\",\"resets_at\":\"2026-01-04T10:00:00.000Z\"}],\"five_hours\":[]}}]}]}")
    (run-effect 6)
    (expect-text (test-id "weekly-limit") "90%")
    (change (label "Each session's context") "100")
    (expect-text (test-id "default-limit") "100% · saving…")
    (stub-http "limit" :url "/liton/v1/call" :status 200 :body "{\"Ok\":{\"Rejected\":\"the daemon is busy\"}}")
    (run-effect 7)
    (expect-text (test-id "default-limit") "No limit")
    (expect-text (test-id "notice") "the daemon is busy")
    (click (role button :name "Refresh"))
    (expect-disabled (role button :name "Refreshing…") true)
    (stub-http "refresh" :url "/liton/v1/call" :status 200 :body "{\"Ok\":\"Accepted\"}")
    (run-effect 8)
    (expect-disabled (role button :name "Refresh") false)
  )
)
