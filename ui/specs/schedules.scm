(test "Liton — Schedules, over the Developer preset's Workspaces, lists each schedule with its status, cadence in words, target and next run; one opened shows its runs, each opening its session, and pauses, resumes, runs now and deletes at once"
  (setup (initial-time "2026-01-02T10:00:00Z"))
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"workspaces\",\"version\":1},{\"name\":\"schedules\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Fix tests\",\"updated\":\"2026-01-02T09:00:00.000Z\",\"workspace\":{\"directory\":\"/src/app\",\"id\":\"w1\"}},{\"agent\":\"claude\",\"id\":\"s7\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Nightly run\",\"updated\":\"2026-01-02T03:00:00.000Z\",\"workspace\":{\"directory\":\"/src/app\",\"id\":\"w1\"}}]}]},{\"capability\":\"workspaces.v1\",\"topic\":\"list\",\"cursor\":\"l1\",\"events\":[{\"Listed\":{\"projects\":[{\"directory\":\"/src/app\",\"id\":\"p1\",\"name\":\"app\",\"provider\":\"mock\"}],\"workspaces\":[{\"branch\":{\"Branch\":\"main\"},\"changes\":\"Uncounted\",\"directory\":\"/src/app\",\"dirty\":false,\"id\":\"w1\",\"kind\":\"Worktree\",\"labels\":[],\"name\":\"main\",\"pinned\":false,\"project_id\":\"p1\",\"provider\":\"mock\",\"session_ids\":[\"s1\",\"s7\"],\"state\":\"Idle\"}]}}]}]}")
    (run-effect 2)
    (click (test-id "nav-schedules"))
    (expect-visible (role button :name "New schedule"))
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[]}")
    (run-effect 3)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"schedules.v1\",\"topic\":\"schedules\",\"cursor\":\"x1\",\"events\":[{\"Schedules\":[{\"cadence\":{\"Every\":1800000},\"id\":\"h1\",\"name\":\"Check CI\",\"next_run\":\"2026-01-02T10:20:00.000Z\",\"prompt\":\"Is CI green?\",\"provider\":\"mock\",\"status\":\"Active\",\"target\":{\"Session\":\"s1\"}},{\"cadence\":{\"Cron\":{\"expression\":\"0 9 * * *\"}},\"id\":\"n1\",\"name\":\"\",\"prompt\":\"Update the deps\",\"provider\":\"mock\",\"status\":\"Paused\",\"target\":{\"NewSession\":{\"agent\":\"claude\",\"archive_on_finish\":true,\"isolation\":\"Worktree\",\"place\":{\"Workspace\":\"w1\"}}}}]}]}]}")
    (run-effect 4)
    (expect-visible (role button :name "Check CI"))
    (expect-visible (text "Every 30 minutes"))
    (expect-visible (text "Heartbeat: Fix tests"))
    (expect-visible (text "next in 20m"))
    (expect-visible (text "Every day at 09:00"))
    (expect-visible (text "New claude in w1"))
    (click (role button :name "Update the deps"))
    (expect-attr (role button :name "Update the deps") aria-expanded "true")
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"schedules.v1\",\"topic\":\"schedules\",\"cursor\":\"x1\",\"events\":[{\"Schedules\":[{\"cadence\":{\"Every\":1800000},\"id\":\"h1\",\"name\":\"Check CI\",\"next_run\":\"2026-01-02T10:20:00.000Z\",\"prompt\":\"Is CI green?\",\"provider\":\"mock\",\"status\":\"Active\",\"target\":{\"Session\":\"s1\"}},{\"cadence\":{\"Cron\":{\"expression\":\"0 9 * * *\"}},\"id\":\"n1\",\"name\":\"\",\"prompt\":\"Update the deps\",\"provider\":\"mock\",\"status\":\"Paused\",\"target\":{\"NewSession\":{\"agent\":\"claude\",\"archive_on_finish\":true,\"isolation\":\"Worktree\",\"place\":{\"Workspace\":\"w1\"}}}}]}]},{\"capability\":\"schedules.v1\",\"topic\":\"runs/n1\",\"cursor\":\"r1\",\"events\":[{\"Runs\":[{\"ended\":\"2026-01-02T03:04:00.000Z\",\"id\":\"n1-run-1\",\"output\":\"Updated 3 deps.\",\"scheduled_for\":\"2026-01-02T03:00:00.000Z\",\"session_id\":\"s7\",\"started\":\"2026-01-02T03:00:00.000Z\",\"status\":\"Succeeded\"}]}]}]}")
    (run-effect 5)
    (expect-visible (text "Updated 3 deps."))
    (click (role button :name "Resume"))
    (expect-visible (role status :name "Resuming…"))
    (expect-visible (role button :name "Pause"))
    (stub-http "resume" :url "/liton/v1/call" :status 200 :body "{\"Ok\":\"Accepted\"}")
    (run-effect 6)
    (click (role button :name "Run now"))
    (expect-visible (role status :name "Running…"))
    (stub-http "run" :url "/liton/v1/call" :status 200 :body "{\"Ok\":{\"Rejected\":\"the agent is busy\"}}")
    (run-effect 8)
    (expect-absent (role status :name "Running…"))
    (expect-visible (text "the agent is busy"))
    (click (role button :name "Delete"))
    (expect-absent (role button :name "Update the deps"))
  )
)
