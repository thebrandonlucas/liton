(test "Liton — Settings and the palette offer only the surfaces whose navigators and views the daemon offers what they need, and a key of one it doesn't does nothing"
  (steps
    (expect-attr (role button :name "Settings") aria-expanded "false")
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (click (role button :name "Settings"))
    (expect-visible (role button :name "Chat preset"))
    (expect-visible (role button :name "Tiling preset"))
    (expect-absent (role button :name "Developer preset") :never-drawn)
    (expect-absent (role button :name "Inbox preset") :never-drawn)
    (click (role button :name "Tiling preset"))
    (expect-attr (role button :name "Tiling preset") aria-pressed "true")
    (press "Escape")
    (press "Control+k")
    (fill (label "Command or place") "surface")
    (expect-visible (role option :name "Open the Chat surface"))
    (expect-absent (role option :name "Open the Developer surface") :never-drawn)
    (press (label "Command or place") "Escape")
    (press "1")
    (click (role button :name "Settings"))
    (expect-attr (role button :name "Tiling preset") aria-pressed "true")
  )
)
