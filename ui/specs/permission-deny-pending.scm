(test "Liton — Deny hides the prompt at once, and a rejected answer brings it back"
  (steps
    (stub-http "manifest" :url "/api/manifest" :status 200 :body "{\"protocol\":1,\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}]}")
    (run-effect 1)
    (stub-http "poll" :url "/api/chat/poll" :status 200 :body "{\"sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"AwaitingPermission\",\"title\":\"Fix tests\"}],\"timelines\":[]}")
    (run-effect 2)
    (stub-http "poll" :url "/api/chat/poll" :status 200 :body "{\"sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"AwaitingPermission\",\"title\":\"Fix tests\"}],\"timelines\":[{\"session_id\":\"s1\",\"entries\":[{\"event\":{\"PermissionRequested\":{\"description\":\"rm -rf build\",\"request_id\":\"p1\",\"tool\":\"bash\"}},\"sequence\":1}]}]}")
    (run-effect 3)
    (expect-visible (text "Allow bash: rm -rf build?"))
    (click (role button :name "Deny"))
    ; Shown before the daemon answers.
    (expect-absent (role button :name "Deny"))
    (expect-visible (text "Denying…"))
    (expect-pending-effects 2)
    (stub-http "answer" :url "/api/chat" :status 200 :body "{\"Rejected\":\"no pending permission request p1\"}")
    (run-effect 5)
    (expect-absent (text "Denying…"))
    (expect-visible (role button :name "Deny"))
    (expect-visible (text "no pending permission request p1"))
    (click (role button :name "Deny"))
    (expect-visible (text "Denying…"))
    (stub-http "answer" :url "/api/chat" :status 200 :body "\"Accepted\"")
    (run-effect 6)
    (stub-http "poll" :url "/api/chat/poll" :status 200 :body "{\"sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Running\",\"title\":\"Fix tests\"}],\"timelines\":[{\"session_id\":\"s1\",\"entries\":[{\"event\":{\"PermissionAnswered\":{\"allowed\":false,\"request_id\":\"p1\"}},\"sequence\":2}]}]}")
    (run-effect 7)
    (expect-absent (text "Denying…"))
    (expect-absent (role button :name "Deny"))
    (expect-visible (text "denied"))
  )
)
