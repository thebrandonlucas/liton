(test "Liton — Deny hides the prompt at once, and a rejected answer brings it back"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"AwaitingPermission\",\"title\":\"Fix tests\"}]}]}]}")
    (run-effect 2)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/s1\",\"cursor\":\"1\",\"events\":[{\"Entry\":{\"event\":{\"PermissionRequested\":{\"description\":\"rm -rf build\",\"request_id\":\"p1\",\"tool\":\"bash\"}},\"sequence\":1}}]}]}")
    (run-effect 3)
    (expect-visible (text "Allow bash: rm -rf build?"))
    (click (role button :name "Deny"))
    ; Shown before the daemon answers.
    (expect-absent (role button :name "Deny"))
    (expect-visible (text "Denying…"))
    (expect-pending-effects 1)
    (stub-http "answer" :url "/liton/v1/call" :status 200 :body "{\"Err\":{\"code\":\"NotFound\",\"message\":\"no pending permission request p1\"}}")
    (run-effect 4)
    (expect-absent (text "Denying…"))
    (expect-visible (role button :name "Deny"))
    (expect-visible (text "no pending permission request p1"))
    (click (role button :name "Deny"))
    (expect-visible (text "Denying…"))
    (stub-http "answer" :url "/liton/v1/call" :status 200 :body "{\"Ok\":\"Accepted\"}")
    (run-effect 5)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c2\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Running\",\"title\":\"Fix tests\"}]}]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/s1\",\"cursor\":\"2\",\"events\":[{\"Entry\":{\"event\":{\"PermissionAnswered\":{\"allowed\":false,\"request_id\":\"p1\"}},\"sequence\":2}}]}]}")
    (run-effect 6)
    (expect-absent (text "Denying…"))
    (expect-absent (role button :name "Deny"))
    (expect-visible (text "denied"))
  )
)
