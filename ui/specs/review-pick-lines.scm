(test "Liton — a line number picks a line to comment on, a second one the lines between, and a comment shows at once as a draft under them"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"files\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"},{\"capabilities\":[{\"name\":\"review\",\"version\":1}],\"id\":\"review\",\"name\":\"Review\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"fix-auth\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Fix the login redirect\"}]}]}]}")
    (run-effect 2)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/fix-auth\",\"cursor\":\"\",\"events\":[]}]}")
    (run-effect 3)
    (click (role button :name "Files"))
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/fix-auth\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"files.v1\",\"topic\":\"tree/fix-auth/.\",\"cursor\":\"t1\",\"events\":[{\"Tree\":{\"path\":\".\",\"listing\":{\"Listed\":[{\"name\":\"Auth.roc\",\"kind\":\"File\",\"size\":16,\"modified\":\"\"}]}}}]},{\"capability\":\"review.v1\",\"topic\":\"threads/fix-auth\",\"cursor\":\"r0\",\"events\":[{\"Threads\":{\"round\":0,\"next\":1,\"threads\":[],\"comments\":[]}}]}]}")
    (run-effect 4)
    (click (role button :name "Auth.roc"))
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/fix-auth\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"files.v1\",\"topic\":\"tree/fix-auth/.\",\"cursor\":\"t1\",\"events\":[]},{\"capability\":\"files.v1\",\"topic\":\"file/fix-auth/Auth.roc\",\"cursor\":\"f1\",\"events\":[{\"Contents\":{\"path\":\"Auth.roc\",\"read\":{\"Text\":{\"text\":\"login\\nstart\\ngo\\n\",\"truncated\":false,\"size\":16,\"modified\":\"\"}}}}]},{\"capability\":\"review.v1\",\"topic\":\"threads/fix-auth\",\"cursor\":\"r0\",\"events\":[]}]}")
    (run-effect 5)
    (click (role button :name "2"))
    (expect-visible (text "Comment on Auth.roc:2"))
    (click (role button :name "3"))
    (expect-visible (text "Comment on Auth.roc:2-3"))
    ; The line picked again starts again there.
    (click (role button :name "3"))
    (expect-visible (text "Comment on Auth.roc:3"))
    (click (role button :name "2"))
    (expect-visible (text "Comment on Auth.roc:2-3"))
    (fill (label "Your comment") "Why **here**?")
    (click (role button :name "Comment"))
    ; A draft before the daemon answers, as written.
    (expect-pending-effects 1)
    (expect-absent (label "Your comment"))
    (expect-text (test-id "comment-state") "draft")
    (expect-visible (text "Why **here**?"))
    (stub-http "comment" :url "/liton/v1/call" :status 200 :body "{\"Ok\":\"Accepted\"}")
    (run-effect 6)
    (expect-pending-effects 1)
    (expect-text (test-id "comment-state") "draft")
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/fix-auth\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"files.v1\",\"topic\":\"tree/fix-auth/.\",\"cursor\":\"t1\",\"events\":[]},{\"capability\":\"files.v1\",\"topic\":\"file/fix-auth/Auth.roc\",\"cursor\":\"f1\",\"events\":[]},{\"capability\":\"review.v1\",\"topic\":\"threads/fix-auth\",\"cursor\":\"r1\",\"events\":[{\"Threads\":{\"round\":0,\"next\":3,\"threads\":[{\"id\":\"t2\",\"outdated\":false,\"resolved\":false,\"anchor\":{\"path\":\"Auth.roc\",\"scope\":\"File\",\"side\":\"New\",\"start_line\":2,\"end_line\":3,\"quote\":\"start\\\\ngo\"},\"comments\":[{\"id\":\"c1\",\"author\":\"Me\",\"text\":\"Why **here**?\",\"state\":\"Draft\"}]}],\"comments\":[]}}]}]}")
    (run-effect 7)
    (expect-text (test-id "comment-state") "draft")
    (expect-visible (text "Why **here**?"))
    ; A draft is edited in place.
    (click (role button :name "Edit"))
    (expect-value (label "Your comment") "Why **here**?")
    (expect-visible (text "Edit your draft"))
  )
)
