(test "Liton — Settings' Deck lists each surface's parts by the provider offering what they need, greyed where none does; unchecking one hides it on that surface and checking one shows it, without leaving the surface shown"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"workspaces\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"},{\"capabilities\":[{\"name\":\"rooms\",\"version\":1}],\"id\":\"relay\",\"name\":\"Relay\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (click (role button :name "Settings"))
    (click (role button :name "Deck"))
    (click (label "Parts of Rooms"))
    (expect-visible (text "Mock"))
    (expect-visible (text "Relay"))
    (expect-visible (text "Not offered"))
    (expect-checked (label "Rooms on Rooms") true)
    (expect-checked (label "Members on Rooms") false)
    (expect-checked (label "Rooms on Developer") false)
    (expect-disabled (label "CI runs on Rooms") true)
    (check (label "Members on Rooms"))
    (expect-checked (label "Members on Rooms") true)
    (uncheck (label "Rooms on Rooms"))
    (expect-checked (label "Rooms on Rooms") false)
    (expect-attr (role button :name "Surface 1: Developer") aria-pressed "true")
    (click (role button :name "Close settings"))
    (expect-visible (role region :name "Workspaces"))
    (click (role button :name "Surface 2: Rooms"))
    (expect-visible (role region :name "Members"))
    (expect-attr (role button :name "Left drawer") aria-expanded "false")
  )
)
