(test "Liton — past its account's weekly limit, a chat says so above its composer and offers to raise the limit, in Settings' Usage & limits"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"workspaces\",\"version\":1},{\"name\":\"usage\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[{\"id\":\"limits\",\"name\":\"Limits\",\"offers\":{\"name\":\"limits\",\"version\":1},\"uses\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"usage\",\"version\":1}]}],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Fix tests\",\"workspace\":{\"directory\":\"/src/app\",\"id\":\"w1\"},\"usage\":{\"context_used\":170000,\"context_max\":200000}}]}]},{\"capability\":\"attention.v1\",\"topic\":\"items\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspaces.v1\",\"topic\":\"list\",\"cursor\":\"l1\",\"events\":[{\"Listed\":{\"projects\":[{\"directory\":\"/src/app\",\"id\":\"p1\",\"name\":\"app\",\"provider\":\"mock\"}],\"workspaces\":[{\"branch\":{\"Branch\":\"main\"},\"changes\":\"Uncounted\",\"directory\":\"/src/app\",\"dirty\":false,\"id\":\"w1\",\"kind\":\"Checkout\",\"labels\":[],\"name\":\"main\",\"pinned\":false,\"project_id\":\"p1\",\"provider\":\"mock\",\"session_ids\":[\"s1\"],\"state\":\"Idle\"}]}}]},{\"capability\":\"chat.v1\",\"topic\":\"agents\",\"cursor\":\"a1\",\"events\":[{\"Agents\":[{\"agent\":\"claude\",\"provider\":\"mock\"},{\"agent\":\"codex\",\"provider\":\"mock\"}]}]}]}")
    (run-effect 2)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"limits.v1\",\"topic\":\"status\",\"cursor\":\"s1\",\"events\":[{\"Limits\":{\"limits\":[{\"scope\":\"Week\",\"percent\":90}],\"sessions\":[{\"session_id\":\"s1\",\"used_pct\":85,\"state\":\"Ok\"}],\"weeks\":[{\"provider\":\"mock\",\"source\":\"claude\",\"account\":\"claude@mock\",\"used_pct\":92,\"limit_pct\":90,\"state\":\"Over\"}]}}]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/s1\",\"cursor\":\"1\",\"events\":[{\"Entry\":{\"event\":{\"StatusChanged\":\"Idle\"},\"sequence\":1}}]}]}")
    (run-effect 3)
    (expect-text (test-id "limit-bar") "The claude account is over its weekly limit: 92% of 90%. New messages and agents on it are refused.Raise the limit")
    (click (role button :name "Raise the limit"))
    (expect-visible (role heading :name "Usage & limits"))
    (expect-text (test-id "limit-bar") "The claude account is over its weekly limit: 92% of 90%. New messages and agents on it are refused.Raise the limit")
  )
)
