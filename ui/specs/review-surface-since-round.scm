(test "Liton — Since round shows only the files the agent changed since the round this browser sent, in the view and the navigator, and says when it can't tell"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"workspace.git\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"},{\"capabilities\":[{\"name\":\"review\",\"version\":1}],\"id\":\"review\",\"name\":\"Review\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"fix-auth\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Fix the login redirect\"}]}]}]}")
    (run-effect 2)
    (press "6")
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/fix-auth\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"changes/fix-auth/Uncommitted\",\"cursor\":\"g-f1\",\"events\":[{\"Changes\":{\"workspace\":{\"Known\":{\"directory\":\"/w\",\"id\":\"/w\",\"kind\":\"Checkout\",\"name\":\"w\",\"provider\":\"mock\",\"repository_root\":\"/w\"}},\"status\":{\"Status\":{\"ahead\":1,\"base\":{\"Base\":\"main\"},\"behind\":0,\"branch\":{\"Branch\":\"fix-auth\"},\"dirty\":true,\"upstream\":\"NoUpstream\"}},\"changes\":{\"scope\":\"Uncommitted\",\"fingerprint\":\"f1\",\"files\":[{\"additions\":1,\"body\":\"Text\",\"change\":\"Modified\",\"deletions\":1,\"path\":\"src/Auth.roc\"},{\"additions\":2,\"body\":\"Text\",\"change\":\"Added\",\"deletions\":0,\"path\":\"docs/notes.md\"}]},\"commits\":[]}}]},{\"capability\":\"review.v1\",\"topic\":\"threads/fix-auth\",\"cursor\":\"r1\",\"events\":[{\"Threads\":{\"round\":1,\"next\":5,\"threads\":[{\"id\":\"t2\",\"outdated\":false,\"resolved\":false,\"anchor\":{\"path\":\"src/Auth.roc\",\"scope\":\"Uncommitted\",\"side\":\"New\",\"start_line\":51,\"end_line\":51,\"quote\":\"go(came_from)\"},\"comments\":[{\"id\":\"c1\",\"author\":\"Me\",\"text\":\"Where does came_from come from?\",\"state\":{\"Sent\":1}}]},{\"id\":\"t4\",\"outdated\":false,\"resolved\":false,\"anchor\":{\"path\":\"docs/notes.md\",\"scope\":\"Uncommitted\",\"side\":\"New\",\"start_line\":2,\"end_line\":2,\"quote\":\"Redirects go back.\"},\"comments\":[{\"id\":\"c3\",\"author\":\"Me\",\"text\":\"Back where?\",\"state\":\"Draft\"}]}],\"comments\":[]}}]}]}")
    (run-effect 3)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/fix-auth\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"changes/fix-auth/Uncommitted\",\"cursor\":\"g-f1\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"file/fix-auth/Uncommitted/src%2FAuth.roc\",\"cursor\":\"h1\",\"events\":[{\"File\":{\"path\":\"src/Auth.roc\",\"hunks\":[{\"old_start\":40,\"old_count\":3,\"new_start\":50,\"new_count\":3,\"lines\":[{\"kind\":\"Context\",\"text\":\"login\",\"old_line\":40,\"new_line\":50},{\"kind\":\"Removed\",\"text\":\"go(login_page)\",\"old_line\":41,\"new_line\":0},{\"kind\":\"Added\",\"text\":\"go(came_from)\",\"old_line\":0,\"new_line\":51},{\"kind\":\"Context\",\"text\":\"start\",\"old_line\":42,\"new_line\":52}]}]}}]},{\"capability\":\"workspace.git.v1\",\"topic\":\"file/fix-auth/Uncommitted/docs%2Fnotes.md\",\"cursor\":\"h1\",\"events\":[{\"File\":{\"path\":\"docs/notes.md\",\"hunks\":[{\"old_start\":0,\"old_count\":0,\"new_start\":1,\"new_count\":2,\"lines\":[{\"kind\":\"Added\",\"text\":\"# Notes\",\"old_line\":0,\"new_line\":1},{\"kind\":\"Added\",\"text\":\"Redirects go back.\",\"old_line\":0,\"new_line\":2}]}]}}]},{\"capability\":\"review.v1\",\"topic\":\"threads/fix-auth\",\"cursor\":\"r1\",\"events\":[]}]}")
    (run-effect 4)
    ; Round 1 wasn't sent from here, so liton can't tell what changed since.
    (click (role button :name "Since round 1"))
    (expect-attr (role button :name "Since round 1") aria-pressed "true")
    (expect-text (test-id "since-round-note") "liton can't tell what changed since round 1: this browser didn't send it, and no provider keeps the code each round was sent against (review.v1 round diffs).")
    (expect-visible (role group :name "src/Auth.roc"))
    (click (role button :name "Since round 1"))
    (click (role button :name "Finish review"))
    (expect-text (test-id "review-round") "Sending round 2…")
    (stub-http "send" :url "/liton/v1/call" :status 200 :body "{\"Ok\":{\"Sent\":{\"round\":2}}}")
    (run-effect 5)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"fix-auth\",\"provider\":\"mock\",\"status\":\"Running\",\"title\":\"Fix the login redirect\"}]}]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/fix-auth\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"changes/fix-auth/Uncommitted\",\"cursor\":\"g-f1\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"file/fix-auth/Uncommitted/src%2FAuth.roc\",\"cursor\":\"h1\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"file/fix-auth/Uncommitted/docs%2Fnotes.md\",\"cursor\":\"h1\",\"events\":[]},{\"capability\":\"review.v1\",\"topic\":\"threads/fix-auth\",\"cursor\":\"r2\",\"events\":[{\"Threads\":{\"round\":2,\"next\":5,\"threads\":[{\"id\":\"t2\",\"outdated\":false,\"resolved\":false,\"anchor\":{\"path\":\"src/Auth.roc\",\"scope\":\"Uncommitted\",\"side\":\"New\",\"start_line\":51,\"end_line\":51,\"quote\":\"go(came_from)\"},\"comments\":[{\"id\":\"c1\",\"author\":\"Me\",\"text\":\"Where does came_from come from?\",\"state\":{\"Sent\":1}}]},{\"id\":\"t4\",\"outdated\":false,\"resolved\":false,\"anchor\":{\"path\":\"docs/notes.md\",\"scope\":\"Uncommitted\",\"side\":\"New\",\"start_line\":2,\"end_line\":2,\"quote\":\"Redirects go back.\"},\"comments\":[{\"id\":\"c3\",\"author\":\"Me\",\"text\":\"Back where?\",\"state\":{\"Sent\":2}}]}],\"comments\":[]}}]}]}")
    (run-effect 6)
    ; Nothing changed since the round sent from here.
    (click (role button :name "Since round 2"))
    (expect-text (test-id "since-round-note") "Nothing changed since round 2.")
    (expect-absent (role group :name "src/Auth.roc"))
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"fix-auth\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Fix the login redirect\"}]}]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/fix-auth\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"changes/fix-auth/Uncommitted\",\"cursor\":\"g-f1\",\"events\":[]},{\"capability\":\"review.v1\",\"topic\":\"threads/fix-auth\",\"cursor\":\"r2\",\"events\":[]}]}")
    (tick-interval 1000)
    (run-effect 7)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/fix-auth\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"changes/fix-auth/Uncommitted\",\"cursor\":\"g-f3\",\"events\":[{\"Changes\":{\"workspace\":{\"Known\":{\"directory\":\"/w\",\"id\":\"/w\",\"kind\":\"Checkout\",\"name\":\"w\",\"provider\":\"mock\",\"repository_root\":\"/w\"}},\"status\":{\"Status\":{\"ahead\":1,\"base\":{\"Base\":\"main\"},\"behind\":0,\"branch\":{\"Branch\":\"fix-auth\"},\"dirty\":true,\"upstream\":\"NoUpstream\"}},\"changes\":{\"scope\":\"Uncommitted\",\"fingerprint\":\"f3\",\"files\":[{\"additions\":1,\"body\":\"Text\",\"change\":\"Modified\",\"deletions\":1,\"path\":\"src/Auth.roc\"},{\"additions\":2,\"body\":\"Text\",\"change\":\"Added\",\"deletions\":0,\"path\":\"docs/notes.md\"}]},\"commits\":[]}}]},{\"capability\":\"workspace.git.v1\",\"topic\":\"file/fix-auth/Uncommitted/src%2FAuth.roc\",\"cursor\":\"h1\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"file/fix-auth/Uncommitted/docs%2Fnotes.md\",\"cursor\":\"h4\",\"events\":[{\"File\":{\"path\":\"docs/notes.md\",\"hunks\":[{\"old_start\":0,\"old_count\":0,\"new_start\":1,\"new_count\":2,\"lines\":[{\"kind\":\"Added\",\"text\":\"# Notes\",\"old_line\":0,\"new_line\":1},{\"kind\":\"Added\",\"text\":\"Redirects go back to the page asked for.\",\"old_line\":0,\"new_line\":2}]}]}}]},{\"capability\":\"review.v1\",\"topic\":\"threads/fix-auth\",\"cursor\":\"r2\",\"events\":[]}]}")
    (tick-interval 1000)
    (run-effect 8)
    ; The agent revised one file: only it shows, in the view and the navigator.
    (expect-text (test-id "since-round-note") "1 file changed since round 2.")
    (expect-visible (text "Redirects go back to the page asked for."))
    (expect-absent (role group :name "src/Auth.roc"))
    (expect-text (role region :name "Changed files") "Changed filesFix the login redirect1 file+2−0docs+2 −0notes.mdadded1+2 −0")
  )
)
