(test "Liton — a plan to approve shows as a card, its plan as Markdown and the provider's own choices, each hiding it at once, and a refused answer brings it back"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"AwaitingPermission\",\"title\":\"Fix tests\"}]}]}]}")
    (run-effect 2)
    ; The mock asks for a plan when a message mentions one.
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/s1\",\"cursor\":\"2\",\"events\":[{\"Entry\":{\"event\":{\"UserMessage\":{\"text\":\"Plan the fix\"}},\"sequence\":1}},{\"Entry\":{\"event\":{\"PermissionRequested\":{\"body\":\"## Plan\\n\\n1. Find where an empty list reaches `first` in `src/Main.roc`.\\n2. Return **an empty result** there instead of crashing.\\n3. Add a test for the empty case, and run `zig build test`.\",\"choices\":[{\"allows\":false,\"id\":\"reject\",\"label\":\"Reject\",\"style\":\"Danger\"},{\"allows\":true,\"id\":\"implement\",\"label\":\"Implement\",\"style\":\"Primary\"},{\"allows\":true,\"id\":\"implement_resume\",\"label\":\"Implement with Auto\",\"style\":\"Secondary\"}],\"description\":\"Plan: handle the empty case\",\"request_id\":\"permission-2\",\"tool\":\"ExitPlanMode\"}},\"sequence\":2}}]}]}")
    (run-effect 3)
    (expect-visible (text "Plan: handle the empty case"))
    (expect-visible (role heading :name "Plan"))
    (expect-visible (text "an empty result"))
    (expect-visible (role button :name "Reject"))
    (expect-visible (role button :name "Implement with Auto"))
    (expect-absent (role button :name "Allow") :never-drawn)
    (click (role button :name "Implement"))
    ; Shown before the daemon answers.
    (expect-absent (role button :name "Implement"))
    (expect-absent (role heading :name "Plan"))
    (expect-visible (text "Allowing…"))
    (stub-http "answer" :url "/liton/v1/call" :status 200 :body "{\"Err\":{\"code\":\"BadRequest\",\"message\":\"permission-2 offers no such choice\"}}")
    (run-effect 4)
    (expect-absent (text "Allowing…"))
    (expect-visible (role button :name "Implement"))
    (expect-visible (text "permission-2 offers no such choice"))
    (click (role button :name "Reject"))
    (expect-absent (role button :name "Reject"))
    (expect-visible (text "Denying…"))
    (stub-http "answer" :url "/liton/v1/call" :status 200 :body "{\"Ok\":\"Accepted\"}")
    (run-effect 5)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c2\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Running\",\"title\":\"Fix tests\"}]}]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/s1\",\"cursor\":\"3\",\"events\":[{\"Entry\":{\"event\":{\"PermissionAnswered\":{\"allowed\":false,\"choice\":\"reject\",\"request_id\":\"permission-2\"}},\"sequence\":3}}]}]}")
    (run-effect 6)
    (expect-absent (text "Denying…"))
    (expect-absent (role button :name "Reject"))
    (expect-visible (text "denied"))
  )
)
