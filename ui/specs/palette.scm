(test "Liton — Ctrl+K or Cmd+K opens the palette: typing filters its commands and places, the arrows pick one, Enter or a click runs it, and Escape or Ctrl+K again closes it"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"workspaces\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Running\",\"title\":\"Fix tests\",\"updated\":\"2026-01-01T10:00:00.000Z\",\"workspace\":{\"directory\":\"/src/app\",\"id\":\"w1\"}},{\"agent\":\"claude\",\"id\":\"s2\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Write docs\",\"updated\":\"2026-01-01T09:00:00.000Z\",\"workspace\":{\"directory\":\"/src/app\",\"id\":\"w2\"}}]}]},{\"capability\":\"attention.v1\",\"topic\":\"items\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspaces.v1\",\"topic\":\"list\",\"cursor\":\"l1\",\"events\":[{\"Listed\":{\"projects\":[{\"directory\":\"/src/app\",\"id\":\"p1\",\"name\":\"app\",\"provider\":\"mock\"}],\"workspaces\":[{\"branch\":{\"Branch\":\"main\"},\"changes\":\"Uncounted\",\"directory\":\"/src/app\",\"dirty\":false,\"id\":\"w1\",\"kind\":\"Checkout\",\"labels\":[],\"name\":\"main\",\"pinned\":false,\"project_id\":\"p1\",\"provider\":\"mock\",\"session_ids\":[\"s1\"],\"state\":\"Working\"},{\"branch\":{\"Branch\":\"docs\"},\"changes\":\"Uncounted\",\"directory\":\"/src/app\",\"dirty\":false,\"id\":\"w2\",\"kind\":\"Worktree\",\"labels\":[],\"name\":\"docs\",\"pinned\":false,\"project_id\":\"p1\",\"provider\":\"mock\",\"session_ids\":[\"s2\"],\"state\":\"Idle\"},{\"branch\":{\"Branch\":\"scratch\"},\"changes\":\"Uncounted\",\"directory\":\"/src/app\",\"dirty\":false,\"id\":\"w3\",\"kind\":\"Worktree\",\"labels\":[],\"name\":\"scratch\",\"pinned\":false,\"project_id\":\"p1\",\"provider\":\"mock\",\"session_ids\":[],\"state\":\"Idle\"}]}}]}]}")
    (run-effect 2)
    (expect-text (test-id "session-title") "Fix tests")
    (press "Control+k")
    (expect-visible (role dialog :name "Palette"))
    (expect-focused (label "Command or place"))
    ; Each command shows its keys.
    (expect-text (role option :name "Open or close Settings") "Open or close SettingsViewCtrl+,")
    (expect-text (role option :name "docs") "docsWorkspace in appG then 2")
    ; Typing filters, and Enter runs the entry picked.
    (fill (label "Command or place") "settings")
    (expect-visible (role option :name "Open or close Settings"))
    (expect-absent (role option :name "Fix tests"))
    (press (label "Command or place") "Enter")
    (expect-absent (role dialog :name "Palette"))
    (expect-visible (role region :name "Settings"))
    (press "Escape")
    (expect-absent (role region :name "Settings"))
    ; Cmd+K in a text box too; a session is a place to go.
    (press (label "Message") "Meta+k")
    (fill (label "Command or place") "write")
    (press (label "Command or place") "Enter")
    (expect-text (test-id "session-title") "Write docs")
    ; The arrows move the pick, round from the end.
    (press "Control+k")
    (fill (label "Command or place") "preset")
    (expect-attr (role option :name "Show the Developer preset") aria-selected "true")
    (press (label "Command or place") "ArrowDown")
    (expect-attr (role option :name "Show the Inbox preset") aria-selected "true")
    (expect-attr (role option :name "Show the Developer preset") aria-selected "false")
    (press (label "Command or place") "Control+p")
    (press (label "Command or place") "ArrowUp")
    (expect-attr (role option :name "Show the Developer preset") aria-selected "false")
    (fill (label "Command or place") "nothing like it")
    (expect-visible (text "Nothing matches."))
    ; Escape closes it, running nothing.
    (press (label "Command or place") "Escape")
    (expect-absent (role dialog :name "Palette"))
    (expect-text (test-id "session-title") "Write docs")
    ; Ctrl+K or Cmd+K again closes it.
    (press "Control+k")
    (press (label "Command or place") "Control+k")
    (expect-absent (role dialog :name "Palette"))
    (press "Meta+k")
    (press (label "Command or place") "Meta+k")
    (expect-absent (role dialog :name "Palette"))
    ; A click runs an entry too.
    (press "Control+k")
    (click (role option :name "Fix tests"))
    (expect-absent (role dialog :name "Palette"))
    (expect-text (test-id "session-title") "Fix tests")
  )
)
