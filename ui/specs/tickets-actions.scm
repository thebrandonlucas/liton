(test "Liton — a ticket's status, assignees and a comment change at once, saving until the daemon has them, and a change it refuses is undone with why"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"tickets\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]}]}")
    (run-effect 2)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]}]}")
    (run-effect 3)
    (click (role button :name "Tickets"))
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"tickets.v1\",\"topic\":\"list\",\"cursor\":\"l1\",\"events\":[{\"Tickets\":{\"sources\":[{\"id\":\"gh\",\"provider\":\"mock\",\"name\":\"mock/liton\",\"url\":\"https://example.com/gh\",\"me\":{\"id\":\"ada\",\"name\":\"Ada\"},\"people\":[{\"id\":\"ada\",\"name\":\"Ada\"},{\"id\":\"bo\",\"name\":\"Bo\"}],\"statuses\":[{\"id\":\"open\",\"name\":\"Open\",\"kind\":\"Open\"},{\"id\":\"closed\",\"name\":\"Closed\",\"kind\":\"Done\"}]},{\"id\":\"LIT\",\"provider\":\"mock\",\"name\":\"Liton team\",\"url\":\"https://example.com/LIT\",\"me\":{\"id\":\"ada\",\"name\":\"Ada\"},\"people\":[{\"id\":\"ada\",\"name\":\"Ada\"},{\"id\":\"bo\",\"name\":\"Bo\"}],\"statuses\":[{\"id\":\"todo\",\"name\":\"Todo\",\"kind\":\"Open\"},{\"id\":\"in_progress\",\"name\":\"In Progress\",\"kind\":\"Started\"},{\"id\":\"done\",\"name\":\"Done\",\"kind\":\"Done\"}]}],\"tickets\":[{\"id\":\"LIT-12\",\"provider\":\"mock\",\"source\":\"LIT\",\"key\":\"LIT-12\",\"title\":\"Logging in sends you back to /login\",\"url\":\"https://example.com/LIT/LIT-12\",\"status\":{\"id\":\"in_progress\",\"name\":\"In Progress\",\"kind\":\"Started\"},\"assignees\":[{\"id\":\"ada\",\"name\":\"Ada\"}],\"labels\":[\"bug\"],\"waiting_on\":[],\"branch\":\"fix-auth\",\"updated\":\"2026-01-01T08:30:00.000Z\"},{\"id\":\"gh#9\",\"provider\":\"mock\",\"source\":\"gh\",\"key\":\"#9\",\"title\":\"Document the review flow\",\"url\":\"https://example.com/gh/9\",\"status\":{\"id\":\"open\",\"name\":\"Open\",\"kind\":\"Open\"},\"assignees\":[],\"labels\":[\"docs\"],\"waiting_on\":[\"ada\"],\"updated\":\"2026-01-01T07:00:00.000Z\"},{\"id\":\"gh#4\",\"provider\":\"mock\",\"source\":\"gh\",\"key\":\"#4\",\"title\":\"Archive sessions from their menu\",\"url\":\"https://example.com/gh/4\",\"status\":{\"id\":\"closed\",\"name\":\"Closed\",\"kind\":\"Done\"},\"assignees\":[{\"id\":\"bo\",\"name\":\"Bo\"}],\"labels\":[],\"waiting_on\":[],\"updated\":\"2025-12-20T09:00:00.000Z\"}]}}]},{\"capability\":\"tickets.v1\",\"topic\":\"links\",\"cursor\":\"k1\",\"events\":[{\"Links\":[]}]}]}")
    (run-effect 4)
    (click (role button :name "LIT-12 Logging in sends you back to /login"))
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"tickets.v1\",\"topic\":\"list\",\"cursor\":\"l0\",\"events\":[]},{\"capability\":\"tickets.v1\",\"topic\":\"links\",\"cursor\":\"k1\",\"events\":[]},{\"capability\":\"tickets.v1\",\"topic\":\"ticket/LIT-12\",\"cursor\":\"t441\",\"events\":[{\"Ticket\":{\"summary\":{\"id\":\"LIT-12\",\"provider\":\"mock\",\"source\":\"LIT\",\"key\":\"LIT-12\",\"title\":\"Logging in sends you back to /login\",\"url\":\"https://example.com/LIT/LIT-12\",\"status\":{\"id\":\"in_progress\",\"name\":\"In Progress\",\"kind\":\"Started\"},\"assignees\":[{\"id\":\"ada\",\"name\":\"Ada\"}],\"labels\":[\"bug\"],\"waiting_on\":[],\"branch\":\"fix-auth\",\"updated\":\"2026-01-01T08:30:00.000Z\"},\"body\":\"After logging in, the app redirects to `/login`.\",\"comments\":[]}}]}]}")
    (run-effect 5)
    (expect-text (test-id "ticket-saving") "")
    ; Refused, a status goes back, with why.
    (select-option (label "Set status") "done")
    (expect-text (test-id "ticket-status") "Done")
    (expect-text (test-id "ticket-saving") "Saving…")
    (stub-http "status" :url "/liton/v1/call" :status 200 :body "{\"Err\":{\"code\":\"Refused\",\"message\":\"the tracker is read-only\"}}")
    (run-effect 6)
    (expect-text (test-id "ticket-status") "In Progress")
    (expect-visible (text "the tracker is read-only"))
    ; Accepted, an assignee shows until the poll it asks for has it.
    (check (label "Bo"))
    (expect-visible (text "Ada, Bo"))
    (expect-text (test-id "ticket-saving") "Saving…")
    (stub-http "assign" :url "/liton/v1/call" :status 200 :body "{\"Ok\":\"Accepted\"}")
    (run-effect 7)
    (expect-visible (text "Ada, Bo"))
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"tickets.v1\",\"topic\":\"list\",\"cursor\":\"l1571\",\"events\":[{\"Tickets\":{\"sources\":[{\"id\":\"gh\",\"provider\":\"mock\",\"name\":\"mock/liton\",\"url\":\"https://example.com/gh\",\"me\":{\"id\":\"ada\",\"name\":\"Ada\"},\"people\":[{\"id\":\"ada\",\"name\":\"Ada\"},{\"id\":\"bo\",\"name\":\"Bo\"}],\"statuses\":[{\"id\":\"open\",\"name\":\"Open\",\"kind\":\"Open\"},{\"id\":\"closed\",\"name\":\"Closed\",\"kind\":\"Done\"}]},{\"id\":\"LIT\",\"provider\":\"mock\",\"name\":\"Liton team\",\"url\":\"https://example.com/LIT\",\"me\":{\"id\":\"ada\",\"name\":\"Ada\"},\"people\":[{\"id\":\"ada\",\"name\":\"Ada\"},{\"id\":\"bo\",\"name\":\"Bo\"}],\"statuses\":[{\"id\":\"todo\",\"name\":\"Todo\",\"kind\":\"Open\"},{\"id\":\"in_progress\",\"name\":\"In Progress\",\"kind\":\"Started\"},{\"id\":\"done\",\"name\":\"Done\",\"kind\":\"Done\"}]}],\"tickets\":[{\"id\":\"LIT-12\",\"provider\":\"mock\",\"source\":\"LIT\",\"key\":\"LIT-12\",\"title\":\"Logging in sends you back to /login\",\"url\":\"https://example.com/LIT/LIT-12\",\"status\":{\"id\":\"in_progress\",\"name\":\"In Progress\",\"kind\":\"Started\"},\"assignees\":[{\"id\":\"ada\",\"name\":\"Ada\"},{\"id\":\"bo\",\"name\":\"Bo\"}],\"labels\":[\"bug\"],\"waiting_on\":[],\"branch\":\"fix-auth\",\"updated\":\"2026-01-01T08:30:00.000Z\"},{\"id\":\"gh#9\",\"provider\":\"mock\",\"source\":\"gh\",\"key\":\"#9\",\"title\":\"Document the review flow\",\"url\":\"https://example.com/gh/9\",\"status\":{\"id\":\"open\",\"name\":\"Open\",\"kind\":\"Open\"},\"assignees\":[],\"labels\":[\"docs\"],\"waiting_on\":[\"ada\"],\"updated\":\"2026-01-01T07:00:00.000Z\"},{\"id\":\"gh#4\",\"provider\":\"mock\",\"source\":\"gh\",\"key\":\"#4\",\"title\":\"Archive sessions from their menu\",\"url\":\"https://example.com/gh/4\",\"status\":{\"id\":\"closed\",\"name\":\"Closed\",\"kind\":\"Done\"},\"assignees\":[{\"id\":\"bo\",\"name\":\"Bo\"}],\"labels\":[],\"waiting_on\":[],\"updated\":\"2025-12-20T09:00:00.000Z\"}]}}]},{\"capability\":\"tickets.v1\",\"topic\":\"links\",\"cursor\":\"k1\",\"events\":[]},{\"capability\":\"tickets.v1\",\"topic\":\"ticket/LIT-12\",\"cursor\":\"t0\",\"events\":[]}]}")
    (run-effect 8)
    (expect-visible (text "Ada, Bo"))
    (expect-text (test-id "ticket-saving") "")
    ; A comment shows at once, as yours.
    (fill (label "Comment on this ticket") "On it.")
    (click (role button :name "Comment"))
    (expect-visible (text "On it."))
    (expect-visible (text "Ada"))
    (expect-text (test-id "ticket-saving") "Saving…")
    (expect-value (label "Comment on this ticket") "")
    (stub-http "comment" :url "/liton/v1/call" :status 200 :body "{\"Err\":{\"code\":\"BadRequest\",\"message\":\"a comment needs some text\"}}")
    (run-effect 9)
    (expect-absent (text "On it."))
    (expect-visible (text "a comment needs some text"))
  )
)
