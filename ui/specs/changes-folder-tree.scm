(test "Liton — the Changes pane lists its files as a tree of folders with their lines, and a folder folds and unfolds at once"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"workspace.git\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"fix-auth\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Fix the login redirect\"}]}]}]}")
    (run-effect 2)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/fix-auth\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"changes/fix-auth/Uncommitted\",\"cursor\":\"g1\",\"events\":[{\"Changes\":{\"workspace\":{\"Known\":{\"directory\":\"/w\",\"id\":\"/w\",\"kind\":\"Checkout\",\"name\":\"w\",\"provider\":\"mock\",\"repository_root\":\"/w\"}},\"status\":{\"Status\":{\"ahead\":1,\"base\":{\"Base\":\"main\"},\"behind\":0,\"branch\":{\"Branch\":\"fix-auth\"},\"dirty\":true,\"upstream\":\"NoUpstream\"}},\"changes\":{\"scope\":\"Uncommitted\",\"fingerprint\":\"f1\",\"files\":[{\"additions\":1,\"body\":\"Text\",\"change\":\"Modified\",\"deletions\":1,\"path\":\"src/Auth.roc\"},{\"additions\":5,\"body\":\"Text\",\"change\":\"Added\",\"deletions\":0,\"path\":\"src/ui/Login.roc\"},{\"additions\":2,\"body\":\"Text\",\"change\":\"Deleted\",\"deletions\":3,\"path\":\"README.md\"}]},\"commits\":[]}}]}]}")
    (run-effect 3)
    ; Folders first, each with the lines of the files under it.
    (expect-attr (role button :name "src") aria-expanded "true")
    (expect-visible (text "+6 −1"))
    (expect-attr (role button :name "src/ui") aria-expanded "true")
    (expect-visible (role button :name "src/ui/Login.roc"))
    (expect-visible (role button :name "README.md"))
    (expect-visible (text "deleted"))
    (click (role button :name "src"))
    (expect-attr (role button :name "src") aria-expanded "false")
    (expect-absent (role button :name "src/Auth.roc"))
    (expect-absent (role button :name "src/ui"))
    (click (role button :name "src"))
    (expect-visible (role button :name "src/Auth.roc"))
    (click (role button :name "src/ui/Login.roc"))
    (expect-attr (role button :name "src/ui/Login.roc") aria-pressed "true")
  )
)
