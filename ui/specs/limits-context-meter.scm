(test "Liton — a chat's context meter turns amber near its session's limit and red past it, its popover's slider sets the session's limit at once, shown pending until the daemon takes it, and Compact there sends /compact"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"usage\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[{\"id\":\"limits\",\"name\":\"Limits\",\"offers\":{\"name\":\"limits\",\"version\":1},\"uses\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"usage\",\"version\":1}]}],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Fix tests\",\"usage\":{\"context_used\":150000,\"context_max\":200000}}]}]}]}")
    (run-effect 2)
    (expect-attr (role button :name "Context: 75% used") class "context-ring")
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"limits.v1\",\"topic\":\"status\",\"cursor\":\"l1\",\"events\":[{\"Limits\":{\"limits\":[{\"scope\":\"Default\",\"percent\":80}],\"sessions\":[{\"session_id\":\"s1\",\"used_pct\":75,\"limit_pct\":80,\"state\":\"Near\"}],\"weeks\":[]}}]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/s1\",\"cursor\":\"1\",\"events\":[{\"Entry\":{\"event\":{\"StatusChanged\":\"Idle\"},\"sequence\":1}}]}]}")
    (run-effect 3)
    (expect-attr (role button :name "Context: 75% used") class "context-ring near")
    (expect-text (test-id "limit-bar") "Near its context limit: 75% of 80%.Compact")
    (click (role button :name "Context: 75% used"))
    (expect-visible (test-id "context-usage"))
    (expect-text (test-id "context-limit") "80% (default)")
    (expect-value (label "Context limit") "80")
    ; Its own limit shows at once, pending, and the ring and bar turn red.
    (change (label "Context limit") "70")
    (expect-text (test-id "context-limit") "70%")
    (expect-attr (role button :name "Context: 75% used") class "context-ring over")
    (expect-text (test-id "limit-bar") "Over its context limit: 75% of 70%. New messages are refused until you compact it or start fresh.CompactStart fresh")
    (stub-http "limit" :url "/liton/v1/call" :status 200 :body "{\"Ok\":\"Accepted\"}")
    (run-effect 4)
    (expect-pending-effects 1)
    (expect-text (test-id "context-limit") "70%")
    ; Refused, it goes back, with why.
    (change (label "Context limit") "0")
    (expect-text (test-id "context-limit") "80% (default)")
    (stub-http "limit" :url "/liton/v1/call" :status 200 :body "{\"Ok\":{\"Rejected\":\"no such session\"}}")
    (run-effect 6)
    (expect-text (test-id "context-limit") "70%")
    (expect-text (test-id "notice") "no such session")
    ; Compact sends /compact, shown sent at once.
    (click (role button :name "Compact the context"))
    (expect-absent (test-id "context-usage"))
    (expect-pending-effects 2)
    (expect-text (test-id "sent-status") "Sending…")
    (expect-visible (text "/compact"))
  )
)
