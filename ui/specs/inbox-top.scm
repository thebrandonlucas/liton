(test "Liton — the inbox's Focus lists only what waits on you, a counter only its state, Jump to opens the palette, and New agent the form to start one where the session opened works"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"protocol\":1,\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"workspaces\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"topics\":[],\"transformers\":[{\"id\":\"attention\",\"name\":\"Attention\",\"offers\":{\"name\":\"attention\",\"version\":1},\"uses\":[{\"name\":\"chat\",\"version\":1}]}]}")
    (run-effect 1)
    (click (role button :name "Settings"))
    (click (role button :name "Inbox preset"))
    (click (role button :name "Settings"))
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"codex\",\"id\":\"s1\",\"model\":\"gpt-5\",\"provider\":\"mock\",\"status\":\"Running\",\"thinking\":\"high\",\"title\":\"Refactor\",\"workspace\":{\"directory\":\"/src/api\",\"id\":\"w2\"}},{\"agent\":\"claude\",\"id\":\"s2\",\"model\":\"claude-opus\",\"provider\":\"mock\",\"status\":\"AwaitingPermission\",\"thinking\":\"medium\",\"title\":\"Fix tests\",\"workspace\":{\"directory\":\"/src/app\",\"id\":\"w1\"}},{\"agent\":\"claude\",\"id\":\"s3\",\"model\":\"claude-opus\",\"provider\":\"mock\",\"status\":\"Finished\",\"thinking\":\"low\",\"title\":\"Write docs\",\"workspace\":{\"directory\":\"/src/app\",\"id\":\"w1\"}}]}],\"topic\":\"sessions\"},{\"capability\":\"attention.v1\",\"cursor\":\"i1\",\"events\":[{\"Items\":[{\"agent\":\"claude\",\"permissions\":[],\"provider\":\"mock\",\"session_id\":\"s2\",\"set_aside\":\"No\",\"signature\":\"NeedsYou 1\",\"state\":\"NeedsYou\",\"summary\":\"Can I?\",\"title\":\"Fix tests\",\"unread\":true,\"updated\":\"2026-01-01T09:00:00.000Z\"},{\"agent\":\"claude\",\"permissions\":[],\"provider\":\"mock\",\"session_id\":\"s3\",\"set_aside\":\"No\",\"signature\":\"Done 1\",\"state\":\"Done\",\"summary\":\"Docs written.\",\"title\":\"Write docs\",\"unread\":true,\"updated\":\"2026-01-01T09:05:00.000Z\"},{\"agent\":\"codex\",\"permissions\":[],\"provider\":\"mock\",\"session_id\":\"s1\",\"set_aside\":\"No\",\"signature\":\"Working 1\",\"state\":\"Working\",\"summary\":\"\",\"title\":\"Refactor\",\"unread\":false,\"updated\":\"2026-01-01T09:03:00.000Z\"}]}],\"topic\":\"items\"},{\"capability\":\"workspaces.v1\",\"cursor\":\"l1\",\"events\":[{\"Listed\":{\"projects\":[{\"directory\":\"/src/app\",\"id\":\"p1\",\"name\":\"app\",\"provider\":\"mock\"},{\"directory\":\"/src/api\",\"id\":\"p2\",\"name\":\"api\",\"provider\":\"mock\"}],\"workspaces\":[{\"branch\":{\"Branch\":\"main\"},\"changes\":\"Uncounted\",\"directory\":\"/src/app\",\"dirty\":false,\"id\":\"w1\",\"kind\":\"Checkout\",\"labels\":[],\"name\":\"main\",\"pinned\":false,\"project_id\":\"p1\",\"provider\":\"mock\",\"session_ids\":[\"s2\",\"s3\"],\"state\":\"NeedsYou\"},{\"branch\":{\"Branch\":\"refactor\"},\"changes\":\"Uncounted\",\"directory\":\"/src/api\",\"dirty\":false,\"id\":\"w2\",\"kind\":\"Checkout\",\"labels\":[],\"name\":\"refactor\",\"pinned\":false,\"project_id\":\"p2\",\"provider\":\"mock\",\"session_ids\":[\"s1\"],\"state\":\"Working\"}]}}],\"topic\":\"list\"},{\"capability\":\"chat.v1\",\"cursor\":\"a1\",\"events\":[{\"Agents\":[{\"agent\":\"claude\",\"provider\":\"mock\"},{\"agent\":\"codex\",\"provider\":\"mock\"}]}],\"topic\":\"agents\"}]}")
    (run-effect 2)
    (expect-text (test-id "counter-NeedsYou") "1waiting on you")
    (expect-text (test-id "counter-Working") "1running")
    (expect-text (test-id "counter-Done") "1done")
    (expect-visible (role button :name "Refactor"))
    (click (role button :name "Focus"))
    (expect-attr (role button :name "Focus") aria-pressed "true")
    (expect-visible (role button :name "Fix tests"))
    (expect-absent (role button :name "Refactor"))
    (expect-absent (role button :name "Write docs"))
    (click (role button :name "Focus"))
    (expect-visible (role button :name "Refactor"))
    (click (test-id "counter-Working"))
    (expect-attr (test-id "counter-Working") aria-pressed "true")
    (expect-visible (role button :name "Refactor"))
    (expect-absent (role button :name "Fix tests"))
    (click (test-id "counter-Working"))
    (expect-visible (role button :name "Fix tests"))
    (click (role button :name "Jump to"))
    (expect-visible (role dialog :name "Palette"))
    (press "Escape")
    (expect-absent (role dialog :name "Palette"))
    (click (role button :name "Write docs"))
    (click (role button :name "New agent"))
    (expect-visible (text "New agent in main"))
    (expect-value (label "Agent") "claude")
    (click (role button :name "Cancel"))
    (expect-absent (text "New agent in main"))
  )
)
