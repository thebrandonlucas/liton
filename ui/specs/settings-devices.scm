(test "Liton — Settings' Passkeys & devices lists your devices, this browser marked; Sign out shows Signing out… at once and drops it, or brings it back with why; Add a device shows Making a code… at once, then the code and its link"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (click (role button :name "Settings"))
    (click (role button :name "Passkeys & devices"))
    (stub-http "passkeys" :url "/liton/v1/passkeys" :status 200 :body "{\"passkeys\":[{\"id\":\"k1\",\"name\":\"Laptop\",\"rp_id\":\"box.example\",\"backed_up\":true,\"created_at\":0,\"used_at\":0,\"current\":true},{\"id\":\"k2\",\"name\":\"Old phone\",\"rp_id\":\"old.example\",\"backed_up\":false,\"created_at\":0,\"used_at\":0,\"current\":false}],\"rp_id\":\"box.example\"}")
    (run-effect 3)
    (stub-http "devices" :url "/liton/v1/devices" :status 200 :body "{\"devices\":[{\"id\":\"d1\",\"name\":\"Browser on a Mac\",\"created_at\":0,\"seen_at\":0,\"expires_at\":0,\"current\":true},{\"id\":\"d2\",\"name\":\"Phone or tablet\",\"created_at\":0,\"seen_at\":0,\"expires_at\":0,\"current\":false},{\"id\":\"d3\",\"name\":\"liton command line\",\"created_at\":0,\"seen_at\":0,\"expires_at\":0,\"current\":false}]}")
    (run-effect 4)
    (expect-visible (text "Browser on a Mac · this browser"))
    (expect-visible (text "Phone or tablet"))
    (click (role button :name "Sign out Phone or tablet"))
    ; Signing out at once, before the daemon answers.
    (expect-visible (text "Signing out…"))
    (stub-http "revoke" :url "/liton/v1/devices/revoke" :status 200 :body "{}")
    (run-effect 5)
    (expect-absent (text "Phone or tablet"))
    (click (role button :name "Sign out liton command line"))
    (expect-visible (text "Signing out…"))
    (stub-http "revoke" :url "/liton/v1/devices/revoke" :status 500 :body "database is locked")
    (run-effect 6)
    ; Refused, it is back, with why.
    (expect-absent (text "Signing out…"))
    (expect-visible (role button :name "Sign out liton command line"))
    (expect-text (test-id "notice") "Couldn't revoke liton command line: the daemon didn't answer.")
    (click (role button :name "Add a device"))
    (expect-visible (role button :name "Making a code…"))
    (stub-http "code" :url "/liton/v1/devices/code" :status 200 :body "{\"code\":\"K7QM-4XWP\",\"expires_at\":600000,\"link\":\"https://liton.example/ui/index.html#pair=K7QM-4XWP\"}")
    (run-effect 7)
    (expect-text (test-id "pair-offered-code") "K7QM-4XWP")
    (expect-text (test-id "pair-link") "https://liton.example/ui/index.html#pair=K7QM-4XWP")
  )
)
