(test "Liton — Settings swaps a part for another of its role that fits and is offered, at once, and resets the surface to its preset"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"workspaces\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (click (role button :name "Settings"))
    (expect-absent (role button :name "Reset to Developer"))
    (expect-value (label "Swap Workspaces for") "workspaces")
    (select-option (label "Swap Workspaces for") "sessions")
    (expect-value (label "Swap Sessions for") "sessions")
    (expect-text (test-id "show-left") "Sessions")
    (expect-attr (role button :name "Developer preset") aria-pressed "false")
    (expect-local-storage "liton.surface" "Developer")
    (click (role button :name "Reset to Developer"))
    (expect-text (test-id "show-left") "Workspaces")
    (expect-attr (role button :name "Developer preset") aria-pressed "true")
    (click (role button :name "Tiling preset"))
    (expect-local-storage "liton.surface" "Tiling")
  )
)
