(test "Liton — a plan to approve in the inbox shows its plan and the provider's choices, an answer hides it at once, and a refused one brings it back"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[{\"id\":\"attention\",\"name\":\"Attention\",\"offers\":{\"name\":\"attention\",\"version\":1},\"uses\":[{\"name\":\"chat\",\"version\":1}]}],\"topics\":[]}")
    (run-effect 1)
    (click (role button :name "Settings"))
    (click (role button :name "Inbox preset"))
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"attention.v1\",\"topic\":\"items\",\"cursor\":\"i1\",\"events\":[{\"Items\":[{\"agent\":\"claude\",\"permissions\":[{\"body\":\"## Plan\\n\\n1. Find where an empty list reaches `first` in `src/Main.roc`.\\n2. Return **an empty result** there instead of crashing.\\n3. Add a test for the empty case, and run `zig build test`.\",\"choices\":[{\"allows\":false,\"id\":\"reject\",\"label\":\"Reject\",\"style\":\"Danger\"},{\"allows\":true,\"id\":\"implement\",\"label\":\"Implement\",\"style\":\"Primary\"},{\"allows\":true,\"id\":\"implement_resume\",\"label\":\"Implement with Auto\",\"style\":\"Secondary\"}],\"description\":\"Plan: handle the empty case\",\"request_id\":\"permission-2\",\"tool\":\"ExitPlanMode\"}],\"provider\":\"mock\",\"session_id\":\"s1\",\"set_aside\":\"No\",\"signature\":\"NeedsYou 1\",\"state\":\"NeedsYou\",\"summary\":\"\",\"title\":\"Fix tests\",\"unread\":false,\"updated\":\"\"}]}]}]}")
    (run-effect 2)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"attention.v1\",\"topic\":\"items\",\"cursor\":\"i1\",\"events\":[{\"Items\":[{\"agent\":\"claude\",\"permissions\":[{\"body\":\"## Plan\\n\\n1. Find where an empty list reaches `first` in `src/Main.roc`.\\n2. Return **an empty result** there instead of crashing.\\n3. Add a test for the empty case, and run `zig build test`.\",\"choices\":[{\"allows\":false,\"id\":\"reject\",\"label\":\"Reject\",\"style\":\"Danger\"},{\"allows\":true,\"id\":\"implement\",\"label\":\"Implement\",\"style\":\"Primary\"},{\"allows\":true,\"id\":\"implement_resume\",\"label\":\"Implement with Auto\",\"style\":\"Secondary\"}],\"description\":\"Plan: handle the empty case\",\"request_id\":\"permission-2\",\"tool\":\"ExitPlanMode\"}],\"provider\":\"mock\",\"session_id\":\"s1\",\"set_aside\":\"No\",\"signature\":\"NeedsYou 1\",\"state\":\"NeedsYou\",\"summary\":\"\",\"title\":\"Fix tests\",\"unread\":false,\"updated\":\"\"}]}]}]}")
    (run-effect 3)
    (expect-visible (text "Plan: handle the empty case"))
    (expect-visible (role heading :name "Plan"))
    (expect-visible (role button :name "Reject Fix tests"))
    (expect-absent (role button :name "Allow Fix tests") :never-drawn)
    (click (role button :name "Implement Fix tests"))
    ; Shown before the daemon answers.
    (expect-absent (role button :name "Implement Fix tests"))
    (expect-absent (role heading :name "Plan"))
    (expect-text (test-id "answer-status") "Allowing…")
    (stub-http "answer" :url "/liton/v1/call" :status 200 :body "{\"Err\":{\"code\":\"NotFound\",\"message\":\"no pending permission request permission-2\"}}")
    (run-effect 4)
    (expect-text (test-id "answer-status") "")
    (expect-visible (role button :name "Implement Fix tests"))
    (expect-visible (text "no pending permission request permission-2"))
  )
)
