(test "Liton — the mic says why while the speech engine is down, and how to allow a microphone the browser blocks"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"},{\"capabilities\":[{\"name\":\"voice\",\"version\":1}],\"id\":\"local-speech\",\"name\":\"Local speech\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Scratch\"}]}]}]}")
    (run-effect 2)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/s1\",\"cursor\":\"1\",\"events\":[]},{\"capability\":\"voice.v1\",\"topic\":\"status\",\"cursor\":\"v1\",\"events\":[{\"Status\":{\"stt\":{\"Down\":\"no engine at 127.0.0.1:6006\"}}}]}]}")
    (run-effect 3)
    (expect-attr (role button :name "Dictate") "aria-disabled" "true")
    (expect-attr (role button :name "Dictate") "title" "Voice is unavailable: no engine at 127.0.0.1:6006")
    (click (role button :name "Dictate"))
    (expect-port-subscriptions "liton/voice/capture" 0)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/s1\",\"cursor\":\"1\",\"events\":[]},{\"capability\":\"voice.v1\",\"topic\":\"status\",\"cursor\":\"v2\",\"events\":[{\"Status\":{\"stt\":\"Ready\"}}]}]}")
    (tick-interval 1000)
    (run-effect 4)
    (expect-no-attr (role button :name "Dictate") "aria-disabled")
    (click (role button :name "Dictate"))
    (expect-text (test-id "voice-status") "Listening")
    (fail-port "liton/voice/capture" "Denied")
    (expect-text (test-id "voice-status") "Microphone blocked")
    (expect-attr (role button :name "Dictate") "title" "The browser blocked the microphone: allow it in this site's settings, then tap to try again")
    (click (role button :name "Dictate"))
    (expect-text (test-id "voice-status") "Listening")
  )
)
