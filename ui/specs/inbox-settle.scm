(test "Liton — Settle, Snooze and Bring back move an item at once, and a rejected settle brings it back"
  (steps
    (stub-http "manifest" :url "/api/manifest" :status 200 :body "{\"protocol\":1,\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"},{\"capabilities\":[{\"name\":\"attention\",\"version\":1}],\"id\":\"liton\",\"name\":\"liton\"}]}")
    (run-effect 1)
    (click (role button :name "Settings"))
    (click (role button :name "Inbox preset"))
    (stub-http "attention" :url "/api/attention" :status 200 :body "[{\"agent\":\"claude\",\"permissions\":[],\"provider\":\"mock\",\"session_id\":\"s1\",\"set_aside\":\"No\",\"signature\":\"Done 4\",\"state\":\"Done\",\"summary\":\"\",\"title\":\"Write docs\"}]")
    (run-effect 3)
    (expect-absent (test-id "later"))
    (click (role button :name "Settle Write docs"))
    ; Shown before the daemon answers.
    (expect-visible (text "Later (1)"))
    (expect-absent (role button :name "Settle Write docs"))
    (stub-http "settle" :url "/api/attention" :status 200 :body "{\"Rejected\":\"no session s1\"}")
    (run-effect 4)
    (expect-absent (test-id "later"))
    (expect-visible (role button :name "Settle Write docs"))
    (expect-visible (text "no session s1"))
    (click (role button :name "Settle Write docs"))
    (expect-visible (text "Later (1)"))
    (stub-http "settle" :url "/api/attention" :status 200 :body "\"Accepted\"")
    (run-effect 5)
    (expect-visible (text "Later (1)"))
    (stub-http "attention" :url "/api/attention" :status 200 :body "[{\"agent\":\"claude\",\"permissions\":[],\"provider\":\"mock\",\"session_id\":\"s1\",\"set_aside\":\"Settled\",\"signature\":\"Done 4\",\"state\":\"Done\",\"summary\":\"\",\"title\":\"Write docs\"}]")
    (run-effect 7)
    (expect-visible (text "Later (1)"))
    (expect-absent (role button :name "Settle Write docs"))
    (click (role button :name "Bring back Write docs"))
    (expect-absent (test-id "later"))
    (click (role button :name "Snooze Write docs"))
    (expect-visible (text "Later (1)"))
  )
)
