(test "Liton — Edit changes one of the daemon's own tickets' title, body and labels at once, saving until the daemon has them, and an empty title says why"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"tickets\",\"version\":1}],\"id\":\"tickets\",\"name\":\"Tickets\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]}]}")
    (run-effect 2)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]}]}")
    (run-effect 3)
    (click (role button :name "Tickets"))
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"tickets.v1\",\"topic\":\"list\",\"cursor\":\"l1\",\"events\":[{\"Tickets\":{\"sources\":[{\"id\":\"tickets/p1\",\"provider\":\"tickets\",\"name\":\"liton\",\"url\":\"\",\"people\":[],\"statuses\":[{\"id\":\"todo\",\"name\":\"Todo\",\"kind\":\"Open\"},{\"id\":\"done\",\"name\":\"Done\",\"kind\":\"Done\"}]}],\"tickets\":[{\"id\":\"tickets/1\",\"provider\":\"tickets\",\"source\":\"tickets/p1\",\"key\":\"LIT-1\",\"title\":\"Drop images\",\"url\":\"\",\"status\":{\"id\":\"todo\",\"name\":\"Todo\",\"kind\":\"Open\"},\"assignees\":[],\"labels\":[\"ui\"],\"waiting_on\":[],\"updated\":\"2026-01-01T08:30:00.000Z\"}]}}]},{\"capability\":\"tickets.v1\",\"topic\":\"links\",\"cursor\":\"k1\",\"events\":[{\"Links\":[]}]}]}")
    (run-effect 4)
    (click (role button :name "LIT-1 Drop images"))
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"tickets.v1\",\"topic\":\"list\",\"cursor\":\"l0\",\"events\":[]},{\"capability\":\"tickets.v1\",\"topic\":\"links\",\"cursor\":\"k1\",\"events\":[]},{\"capability\":\"tickets.v1\",\"topic\":\"ticket/tickets/1\",\"cursor\":\"t1\",\"events\":[{\"Ticket\":{\"summary\":{\"id\":\"tickets/1\",\"provider\":\"tickets\",\"source\":\"tickets/p1\",\"key\":\"LIT-1\",\"title\":\"Drop images\",\"url\":\"\",\"status\":{\"id\":\"todo\",\"name\":\"Todo\",\"kind\":\"Open\"},\"assignees\":[],\"labels\":[\"ui\"],\"waiting_on\":[],\"updated\":\"2026-01-01T08:30:00.000Z\"},\"body\":\"In the composer.\",\"comments\":[]}}]}]}")
    (run-effect 5)
    (click (role button :name "Edit the ticket"))
    (expect-value (label "Ticket title") "Drop images")
    (expect-value (label "Labels") "ui")
    (fill (label "Ticket title") "Drop and paste images")
    (fill (label "Ticket body") "Paste too.")
    (fill (label "Labels") "ui, chat")
    (click (role button :name "Save"))
    (expect-visible (text "Drop and paste images"))
    (expect-visible (text "Paste too."))
    (expect-visible (text "ui · chat"))
    (expect-text (test-id "ticket-saving") "Saving…")
    (stub-http "edit" :url "/liton/v1/call" :status 200 :body "{\"Ok\":\"Accepted\"}")
    (run-effect 6)
    (expect-visible (text "Drop and paste images"))
    ; An empty title sends nothing and says why.
    (click (role button :name "Edit the ticket"))
    (fill (label "Ticket title") " ")
    (click (role button :name "Save"))
    (expect-visible (text "Give the ticket a title."))
  )
)
