(test "Liton — the Files pane lists a context's files, opens a folder and shows a file at once, then its lines numbered and highlighted"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"files\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"fix-auth\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Fix the login redirect\"}]}]}]}")
    (run-effect 2)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/fix-auth\",\"cursor\":\"\",\"events\":[]}]}")
    (run-effect 3)
    ; Files is the right drawer's second tab, followed once shown.
    (click (role button :name "Files"))
    (expect-attr (role region :name "Files") class "pane")
    (expect-text (test-id "file-status") "")
    (expect-visible (text "Loading…"))
    (expect-pending-effects 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/fix-auth\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"files.v1\",\"topic\":\"tree/fix-auth/.\",\"cursor\":\"t1\",\"events\":[{\"Tree\":{\"path\":\".\",\"listing\":{\"Listed\":[{\"name\":\"README.md\",\"kind\":\"File\",\"size\":70,\"modified\":\"\"},{\"name\":\"src\",\"kind\":\"Directory\",\"size\":0,\"modified\":\"\"}]}}}]}]}")
    (run-effect 4)
    (expect-absent (text "Loading…"))
    (expect-visible (role button :name "README.md"))
    ; Folders come first, and open at once.
    (click (role button :name "src"))
    (expect-pending-effects 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/fix-auth\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"files.v1\",\"topic\":\"tree/fix-auth/.\",\"cursor\":\"t1\",\"events\":[]},{\"capability\":\"files.v1\",\"topic\":\"tree/fix-auth/src\",\"cursor\":\"t2\",\"events\":[{\"Tree\":{\"path\":\"src\",\"listing\":{\"Listed\":[{\"name\":\"Auth.roc\",\"kind\":\"File\",\"size\":60,\"modified\":\"\"}]}}}]}]}")
    (run-effect 5)
    (click (role button :name "Auth.roc"))
    (expect-visible (text "src/Auth.roc"))
    (expect-text (test-id "file-status") "Loading…")
    (expect-pending-effects 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/fix-auth\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"files.v1\",\"topic\":\"tree/fix-auth/.\",\"cursor\":\"t1\",\"events\":[]},{\"capability\":\"files.v1\",\"topic\":\"tree/fix-auth/src\",\"cursor\":\"t2\",\"events\":[]},{\"capability\":\"files.v1\",\"topic\":\"file/fix-auth/src%2FAuth.roc\",\"cursor\":\"f1\",\"events\":[{\"Contents\":{\"path\":\"src/Auth.roc\",\"read\":{\"Text\":{\"text\":\"login\\nstart\\n\",\"truncated\":false,\"size\":50,\"modified\":\"\"}}}}]}]}")
    (run-effect 6)
    (expect-text (test-id "file-status") "")
    (expect-visible (text "start"))
    (expect-visible (text "2"))
    ; Closing a folder closes it at once.
    (click (role button :name "src"))
    (expect-absent (role button :name "Auth.roc"))
  )
)
