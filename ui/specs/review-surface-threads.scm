(test "Liton — the Review preset's inspector lists the review's threads, open, resolved or all, each focusing its lines in the view, resolved or replied to at once, and the review's conversation"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"workspace.git\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"},{\"capabilities\":[{\"name\":\"review\",\"version\":1}],\"id\":\"review\",\"name\":\"Review\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"claude\",\"id\":\"fix-auth\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Fix the login redirect\"}]}]}]}")
    (run-effect 2)
    (press "5")
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/fix-auth\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"changes/fix-auth/Uncommitted\",\"cursor\":\"g-f1\",\"events\":[{\"Changes\":{\"workspace\":{\"Known\":{\"directory\":\"/w\",\"id\":\"/w\",\"kind\":\"Checkout\",\"name\":\"w\",\"provider\":\"mock\",\"repository_root\":\"/w\"}},\"status\":{\"Status\":{\"ahead\":1,\"base\":{\"Base\":\"main\"},\"behind\":0,\"branch\":{\"Branch\":\"fix-auth\"},\"dirty\":true,\"upstream\":\"NoUpstream\"}},\"changes\":{\"scope\":\"Uncommitted\",\"fingerprint\":\"f1\",\"files\":[{\"additions\":1,\"body\":\"Text\",\"change\":\"Modified\",\"deletions\":1,\"path\":\"src/Auth.roc\"},{\"additions\":2,\"body\":\"Text\",\"change\":\"Added\",\"deletions\":0,\"path\":\"docs/notes.md\"}]},\"commits\":[]}}]},{\"capability\":\"review.v1\",\"topic\":\"threads/fix-auth\",\"cursor\":\"r1\",\"events\":[{\"Threads\":{\"round\":1,\"next\":8,\"threads\":[{\"id\":\"t4\",\"outdated\":false,\"resolved\":true,\"anchor\":{\"path\":\"docs/notes.md\",\"scope\":\"Uncommitted\",\"side\":\"New\",\"start_line\":2,\"end_line\":2,\"quote\":\"Redirects go back.\"},\"comments\":[{\"id\":\"c3\",\"author\":\"Me\",\"text\":\"Back where?\",\"state\":{\"Sent\":1}}]},{\"id\":\"t6\",\"outdated\":true,\"resolved\":false,\"anchor\":{\"path\":\"src/Auth.roc\",\"scope\":\"Uncommitted\",\"side\":\"New\",\"start_line\":9,\"end_line\":9,\"quote\":\"old()\"},\"comments\":[{\"id\":\"c5\",\"author\":\"Me\",\"text\":\"Is this used?\",\"state\":{\"Sent\":1}}]},{\"id\":\"t2\",\"outdated\":false,\"resolved\":false,\"anchor\":{\"path\":\"src/Auth.roc\",\"scope\":\"Uncommitted\",\"side\":\"New\",\"start_line\":51,\"end_line\":51,\"quote\":\"go(came_from)\"},\"comments\":[{\"id\":\"c1\",\"author\":\"Me\",\"text\":\"Where does came_from come from?\",\"state\":{\"Sent\":1}}]}],\"comments\":[{\"id\":\"c7\",\"author\":\"Me\",\"text\":\"Looks close.\",\"state\":{\"Sent\":1}}]}}]}]}")
    (run-effect 3)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[]},{\"capability\":\"chat.v1\",\"topic\":\"timeline/fix-auth\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"changes/fix-auth/Uncommitted\",\"cursor\":\"g-f1\",\"events\":[]},{\"capability\":\"workspace.git.v1\",\"topic\":\"file/fix-auth/Uncommitted/src%2FAuth.roc\",\"cursor\":\"h1\",\"events\":[{\"File\":{\"path\":\"src/Auth.roc\",\"hunks\":[{\"old_start\":40,\"old_count\":3,\"new_start\":50,\"new_count\":3,\"lines\":[{\"kind\":\"Context\",\"text\":\"login\",\"old_line\":40,\"new_line\":50},{\"kind\":\"Removed\",\"text\":\"go(login_page)\",\"old_line\":41,\"new_line\":0},{\"kind\":\"Added\",\"text\":\"go(came_from)\",\"old_line\":0,\"new_line\":51},{\"kind\":\"Context\",\"text\":\"start\",\"old_line\":42,\"new_line\":52}]}]}}]},{\"capability\":\"workspace.git.v1\",\"topic\":\"file/fix-auth/Uncommitted/docs%2Fnotes.md\",\"cursor\":\"h1\",\"events\":[{\"File\":{\"path\":\"docs/notes.md\",\"hunks\":[{\"old_start\":0,\"old_count\":0,\"new_start\":1,\"new_count\":2,\"lines\":[{\"kind\":\"Added\",\"text\":\"# Notes\",\"old_line\":0,\"new_line\":1},{\"kind\":\"Added\",\"text\":\"Redirects go back.\",\"old_line\":0,\"new_line\":2}]}]}}]},{\"capability\":\"review.v1\",\"topic\":\"threads/fix-auth\",\"cursor\":\"r1\",\"events\":[]}]}")
    (run-effect 4)
    ; The open threads, in the order of the files and lines, the outdated one after.
    (expect-visible (role region :name "Threads"))
    (expect-text (test-id "thread-state-t2") "open")
    (expect-text (test-id "thread-state-t6") "outdated")
    (expect-absent (test-id "thread-state-t4"))
    (expect-visible (text "Looks close."))
    (click (role button :name "Resolved"))
    (expect-attr (role button :name "Resolved") aria-pressed "true")
    (expect-text (test-id "thread-state-t4") "resolved")
    (expect-absent (test-id "thread-state-t2"))
    (click (role button :name "All"))
    (expect-text (test-id "thread-state-t2") "open")
    ; A thread focuses its lines in the view, scrolled to.
    (click (role button :name "src/Auth.roc:51"))
    (expect-attr (test-id "comment-c1") class "comment last focused")
    (expect-scroll 1 (test-id "comment-c1") into-view)
    ; Resolve at once, before the daemon answers.
    (click (role button :name "Resolve src/Auth.roc:51"))
    (expect-pending-effects 1)
    (expect-text (test-id "thread-state-t2") "resolved")
    (expect-visible (role button :name "Reopen src/Auth.roc:51"))
    (stub-http "resolve" :url "/liton/v1/call" :status 200 :body "{\"Ok\":\"Accepted\"}")
    (run-effect 5)
    ; Reply opens the composer under the thread in the view.
    (click (role button :name "Reply to docs/notes.md:2"))
    (expect-visible (text "Reply"))
    (expect-value (label "Your comment") "")
    ; A comment on the whole review shows at once.
    (fill (label "Comment on the whole review") "Ship it once green.")
    (click (role button :name "Add"))
    (expect-visible (text "Ship it once green."))
  )
)
