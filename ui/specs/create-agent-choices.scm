(test "Liton — New agent offers the models, modes and thinking levels of the kind picked, each its default first, the levels those of the model picked"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"workspaces\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[{\"agent\":\"codex\",\"id\":\"s1\",\"provider\":\"mock\",\"status\":\"Idle\",\"title\":\"Fix tests\",\"workspace\":{\"directory\":\"/src/app\",\"id\":\"w1\"}}]}]},{\"capability\":\"attention.v1\",\"topic\":\"items\",\"cursor\":\"\",\"events\":[]},{\"capability\":\"workspaces.v1\",\"topic\":\"list\",\"cursor\":\"l1\",\"events\":[{\"Listed\":{\"projects\":[{\"directory\":\"/src/app\",\"id\":\"p1\",\"name\":\"app\",\"provider\":\"mock\"}],\"workspaces\":[{\"branch\":{\"Branch\":\"main\"},\"changes\":\"Uncounted\",\"directory\":\"/src/app\",\"dirty\":false,\"id\":\"w1\",\"kind\":\"Checkout\",\"labels\":[],\"name\":\"main\",\"pinned\":false,\"project_id\":\"p1\",\"provider\":\"mock\",\"session_ids\":[\"s1\"],\"state\":\"Idle\"}]}}]},{\"capability\":\"chat.v1\",\"topic\":\"agents\",\"cursor\":\"a1\",\"events\":[{\"Agents\":[{\"agent\":\"claude\",\"provider\":\"mock\",\"models\":[{\"id\":\"claude-sonnet-4-5\",\"label\":\"Sonnet 4.5\",\"default\":true,\"context_max\":200000,\"thinking\":[{\"id\":\"low\",\"label\":\"Low\",\"default\":false},{\"id\":\"medium\",\"label\":\"Medium\",\"default\":true},{\"id\":\"high\",\"label\":\"High\",\"default\":false}]},{\"id\":\"claude-opus-4-1\",\"label\":\"Opus 4.1\",\"default\":false,\"context_max\":200000,\"thinking\":[{\"id\":\"high\",\"label\":\"High\",\"default\":true}]}],\"modes\":[{\"id\":\"default\",\"label\":\"Always ask\"},{\"id\":\"plan\",\"label\":\"Plan\"}],\"default_mode\":\"default\"},{\"agent\":\"codex\",\"provider\":\"mock\"}]}]}]}")
    (run-effect 2)
    (click (role button :name "New agent beside Fix tests"))
    (expect-value (label "Agent") "claude")
    (expect-value (label "Model") "")
    (expect-text (label "Model") "Sonnet 4.5 (default)Sonnet 4.5Opus 4.1")
    (expect-text (label "Mode") "Always ask (default)Always askPlan")
    (expect-text (label "Thinking") "Medium (default)LowMediumHigh")
    (select-option (label "Thinking") "low")
    (select-option (label "Mode") "plan")
    ; Opus has no Low: the level goes back to its default.
    (select-option (label "Model") "claude-opus-4-1")
    (expect-value (label "Thinking") "")
    (expect-text (label "Thinking") "High (default)High")
    (expect-value (label "Mode") "plan")
    ; Codex tells no models: a field takes one by name.
    (select-option (label "Agent") "codex")
    (expect-absent (label "Mode"))
    (fill (label "Model") "gpt-5")
    (select-option (label "Agent") "claude")
    (fill (label "First prompt") "Plan the docs")
    (click (role button :name "Start"))
    (expect-absent (role button :name "Start"))
    (expect-text (test-id "session-status") "starting…")
  )
)
