(test "Liton — the deck's strip lists its surfaces, Developer shown; a click, d then ] or [, d then a digit or the palette's Go to surface go to another, each as it was left, and the URL names it"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1},{\"name\":\"workspaces\",\"version\":1},{\"name\":\"rooms\",\"version\":1},{\"name\":\"tickets\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (expect-text (test-id "deck") "DeveloperRoomsReviewBoard")
    (expect-attr (role button :name "Surface 1: Developer") aria-pressed "true")
    (expect-visible (role region :name "Workspaces"))
    ; A click goes to a surface at once, in its own theme, sliding in.
    (click (role button :name "Surface 2: Rooms"))
    (expect-attr (role button :name "Surface 2: Rooms") aria-pressed "true")
    (expect-attr (role button :name "Surface 1: Developer") aria-pressed "false")
    (expect-absent (role region :name "Workspaces"))
    (expect-visible (role region :name "Rooms"))
    (expect-current-location "/#deck=2")
    (expect-attr (test-id "grid") class "grid workbench threads-apart deck-in-next-1")
    ; d then [ goes back, sliding in from the other side. Each surface
    ; keeps its layout: the drawer hidden in Rooms shows in Developer.
    (click (role button :name "Left drawer"))
    (expect-attr (role button :name "Left drawer") aria-expanded "false")
    (press "d")
    (press "[")
    (expect-attr (role button :name "Surface 1: Developer") aria-pressed "true")
    (expect-attr (role button :name "Left drawer") aria-expanded "true")
    (expect-current-location "/#deck=1")
    (expect-attr (test-id "grid") class "grid workbench deck-in-previous-0")
    ; d then a digit goes to that one, d then ] to the next, round from the end.
    (press "d")
    (press "4")
    (expect-attr (role button :name "Surface 4: Board") aria-pressed "true")
    (press "d")
    (press "]")
    (expect-attr (role button :name "Surface 1: Developer") aria-pressed "true")
    (press "Control+k")
    (fill (label "Command or place") "go to surface")
    (expect-visible (role option :name "Go to surface 3: Review"))
    (press (label "Command or place") "ArrowDown")
    (press (label "Command or place") "Enter")
    (expect-attr (role button :name "Surface 3: Review") aria-pressed "true")
    (press "d")
    (press "2")
    (expect-attr (role button :name "Left drawer") aria-expanded "false")
  )
)
