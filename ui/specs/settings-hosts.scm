(test "Liton — Settings' Hosts lists each host with its status, version and when last online; its ⋮ menu disables one at once and removes one after asking, back with why if the daemon refuses; Add host sends a new host at once, its token never shown again, and the dialog says why one can't be added"
  (setup (initial-time "2026-01-02T10:00:00Z"))
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"},{\"capabilities\":[{\"name\":\"hosts\",\"version\":1}],\"id\":\"hosts\",\"name\":\"Hosts\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[]}")
    (run-effect 2)
    (stub-http "poll" :url "/liton/v1/poll" :status 200 :body "{\"topics\":[{\"capability\":\"chat.v1\",\"topic\":\"sessions\",\"cursor\":\"c1\",\"events\":[{\"Sessions\":[]}]},{\"capability\":\"hosts.v1\",\"topic\":\"hosts\",\"cursor\":\"h1\",\"events\":[{\"Hosts\":[{\"enabled\":true,\"kind\":\"Paseo\",\"label\":\"\",\"last_online\":\"2026-01-02T09:57:00.000Z\",\"name\":\"paseo\",\"origin\":\"Environment\",\"status\":\"Online\",\"target\":\"127.0.0.1:6767\",\"version\":\"0.15.3\"},{\"enabled\":true,\"kind\":\"Liton\",\"label\":\"Team\",\"name\":\"team\",\"origin\":\"Added\",\"status\":{\"Error\":\"it refused the token: pair this daemon with it again\"},\"target\":\"https://liton.example\"}]}]}]}")
    (run-effect 3)
    (click (role button :name "Settings"))
    (click (role button :name "Hosts"))
    (expect-visible (text "Paseo · 127.0.0.1:6767 · Online · 0.15.3 · last online 3m · set by the environment"))
    (expect-visible (text "liton · https://liton.example · it refused the token: pair this daemon with it again"))
    (click (role button :name "paseo menu"))
    (expect-absent (role button :name "Remove"))
    (click (role button :name "Disable"))
    ; Disabling at once, before the daemon answers.
    (expect-visible (text "Paseo · 127.0.0.1:6767 · Disabling… · 0.15.3 · last online 3m · set by the environment"))
    (stub-http "disable" :url "/liton/v1/call" :status 200 :body "{\"Ok\":\"Accepted\"}")
    (run-effect 4)
    (click (role button :name "team menu"))
    (click (role button :name "Remove"))
    (expect-visible (text "Remove team? This daemon disconnects from it and forgets its password."))
    (click (role button :name "Remove team"))
    ; Gone at once; refused, it is back with why.
    (expect-absent (text "Team"))
    (stub-http "remove" :url "/liton/v1/call" :status 200 :body "{\"Ok\":{\"Rejected\":\"team is busy\"}}")
    (run-effect 6)
    (expect-visible (text "Team"))
    (expect-text (test-id "notice") "team is busy")
    (click (role button :name "Add host"))
    (expect-visible (role dialog :name "Host"))
    (select-option (label "Kind") "Liton")
    (fill (label "Name") "box")
    (fill (label "Target") "box.local:8095")
    (fill (label "Token") "s3cret")
    (click (role button :name "Add"))
    (expect-text (test-id "host-failed") "a liton host is an http:// or https:// URL, such as https://liton.example, not \"box.local:8095\"")
    (fill (label "Target") "http://box.local:8095")
    (click (role button :name "Add"))
    ; Added at once, connecting, the dialog closed.
    (expect-absent (role dialog :name "Host"))
    (expect-visible (text "liton · http://box.local:8095 · Adding…"))
    (stub-http "add" :url "/liton/v1/call" :status 200 :body "{\"Ok\":\"Accepted\"}")
    (run-effect 7)
    (click (role button :name "box menu"))
    (click (role button :name "Edit"))
    (expect-value (label "Token") "")
    (expect-attr (label "Token") placeholder "Leave empty to keep it")
  )
)
