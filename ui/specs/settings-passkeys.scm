(test "Liton — Settings' Passkeys & devices lists your passkeys, a synced one and one for an old name said so; Delete shows Deleting… at once and drops it; Make a passkey on this device shows Making a passkey… at once, then lists them again"
  (steps
    (stub-http "manifest" :url "/liton/v1/manifest" :status 200 :body "{\"protocol\":1,\"daemon\":{\"id\":\"liton\",\"name\":\"liton\"},\"providers\":[{\"capabilities\":[{\"name\":\"chat\",\"version\":1}],\"id\":\"mock\",\"name\":\"Mock\"}],\"transformers\":[],\"topics\":[]}")
    (run-effect 1)
    (click (role button :name "Settings"))
    (click (role button :name "Passkeys & devices"))
    (stub-http "passkeys" :url "/liton/v1/passkeys" :status 200 :body "{\"passkeys\":[{\"id\":\"k1\",\"name\":\"Laptop\",\"rp_id\":\"box.example\",\"backed_up\":true,\"created_at\":0,\"used_at\":0,\"current\":true},{\"id\":\"k2\",\"name\":\"Old phone\",\"rp_id\":\"old.example\",\"backed_up\":false,\"created_at\":0,\"used_at\":0,\"current\":false}],\"rp_id\":\"box.example\"}")
    (run-effect 3)
    (stub-http "devices" :url "/liton/v1/devices" :status 200 :body "{\"devices\":[{\"id\":\"d1\",\"name\":\"Browser on a Mac\",\"created_at\":0,\"seen_at\":0,\"expires_at\":0,\"current\":true},{\"id\":\"d2\",\"name\":\"Phone or tablet\",\"created_at\":0,\"seen_at\":0,\"expires_at\":0,\"current\":false},{\"id\":\"d3\",\"name\":\"liton command line\",\"created_at\":0,\"seen_at\":0,\"expires_at\":0,\"current\":false}]}")
    (run-effect 4)
    (expect-visible (text "Laptop · this browser"))
    (expect-visible (text "synced"))
    (expect-visible (text "for old.example"))
    (click (role button :name "Delete the passkey Old phone"))
    (expect-visible (text "Deleting…"))
    (stub-http "delete" :url "/liton/v1/passkeys/delete" :status 200 :body "{}")
    (run-effect 5)
    (expect-absent (text "for old.example"))
    ; Then listed again.
    (stub-http "passkeys" :url "/liton/v1/passkeys" :status 200 :body "{\"passkeys\":[{\"id\":\"k1\",\"name\":\"Laptop\",\"rp_id\":\"box.example\",\"backed_up\":true,\"created_at\":0,\"used_at\":0,\"current\":true}],\"rp_id\":\"box.example\"}")
    (run-effect 6)
    (stub-http "devices" :url "/liton/v1/devices" :status 200 :body "{\"devices\":[{\"id\":\"d1\",\"name\":\"Browser on a Mac\",\"created_at\":0,\"seen_at\":0,\"expires_at\":0,\"current\":true},{\"id\":\"d2\",\"name\":\"Phone or tablet\",\"created_at\":0,\"seen_at\":0,\"expires_at\":0,\"current\":false},{\"id\":\"d3\",\"name\":\"liton command line\",\"created_at\":0,\"seen_at\":0,\"expires_at\":0,\"current\":false}]}")
    (run-effect 7)
    (click (role button :name "Make a passkey on this device"))
    (expect-visible (role button :name "Making a passkey…"))
    (stub-http "begin" :url "/liton/v1/passkeys/register/begin" :status 200 :body "{\"challenge\":\"c1\"}")
    (run-effect 8)
    (answer-port 9 reply "\"{}\"")
    (stub-http "finish" :url "/liton/v1/passkeys/register/finish" :status 200 :body "{\"passkey\":{\"id\":\"k3\",\"name\":\"Browser\"}}")
    (run-effect 10)
    (expect-text (test-id "notice") "This browser has a passkey now.")
  )
)
